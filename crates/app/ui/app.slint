// Hexward desktop app. Look and motion follow the Hexward brand book:
// pixel grid, notched corners, hard shadows, Ink / Moss / Oxide, Pixelify Sans + Geist + Geist Mono.
// One window: the title bar is part of the app. Animations run off one frame clock that only
// ticks while something is moving.

import { ScrollView } from "std-widgets.slint";
import "fonts/PixelifySans.ttf";
import "fonts/Geist.ttf";
import "fonts/GeistMono.ttf";

export struct PixelDot { x: int, y: int, c: int }
export struct ThreatRow { name: string, path: string, description: string, chip: string, tone: string, selected: bool, done: bool, confirm-delete: bool }
export struct VaultRow { id: string, name: string, path: string, info: string, confirm: bool }
export struct StartupRow { location: string, name: string, command: string, chip: string, tone: string, fixable: bool, detail: string, publisher: string, signed: bool, size: string, icon: image, has-icon: bool }
export struct DisabledRow { id: string, name: string, info: string }
export struct EventRow { when: string, title: string, detail: string, chip: string, tone: string }
export struct StatItem { label: string, value: string, sub: string, tone: string }
export struct ToastItem { id: int, state: string, title: string, text: string, action: string, target: string, life: float }
export struct StatusRow { name: string, value: string, tone: string }
export struct DriveRow { root: string, label: string, info: string, selected: bool, usage: float }
export struct AllowRow { sha: string, name: string, path: string }
export struct AuditRow { level: string, tone: string, category: string, title: string, place: string, detail: string, evidence: string, fix: string, file: string }
export struct McpRow { name: string, app: string, summary: string, status: string, tone: string, note: string }
export struct GuardRow { when: string, decision: string, tone: string, subject: string, reasons: string }
export struct ExtRow { app: string, name: string, version: string, id: string, notes: string, level: string, tone: string, change: string }
export struct CleanItemRow { id: string, label: string, description: string, size: string, checked: bool, available: bool }
export struct CleanGroup { id: string, name: string, icon: image, has-icon: bool, running: bool, total: string, items: [CleanItemRow] }
export struct TaskRow { pid: int, name: string, detail: string, path: string, icon: image, has-icon: bool, cpu: string, cpu-frac: float, mem: string, mem-frac: float, protected: bool, risky: bool, confirm: bool }

export global Theme {
    in-out property <bool> dark: true;
    out property <color> bg: dark ? #0B0F14 : #F3F6F2;
    out property <color> surface: dark ? #10161E : #FFFFFF;
    out property <color> raised: dark ? #161E28 : #E8EEE9;
    out property <color> line: dark ? #263241 : #C9D4CC;
    out property <color> line-strong: dark ? #3A4B60 : #9FB0A5;
    out property <color> fg: dark ? #E6EDF3 : #0B0F14;
    out property <color> fg-2: dark ? #A3B1C2 : #3F4B57;
    out property <color> fg-3: dark ? #7A8A9D : #5F6B78;
    out property <color> accent: dark ? #4BE07A : #1A7F45;
    out property <color> on-accent: dark ? #05210F : #FFFFFF;
    out property <color> oxide: dark ? #F0743A : #C9531B;
    out property <color> alarm: dark ? #FF5468 : #D21F3C;
    out property <color> amber: dark ? #FFB547 : #A86A00;
    out property <color> signal: dark ? #5AA9FF : #1C64C8;
    out property <color> shadow: dark ? #020406 : #B9C6BD;
    out property <color> dot: dark ? #1A2330 : #D9E2DB;
    out property <color> glint: dark ? #FFFFFF0D : #FFFFFFB0;
    out property <color> mark-hi: dark ? #4BE07A : #2FB463;
    out property <color> mark-lo: dark ? #23A05A : #1A7F45;
    out property <color> heat-0: dark ? #161E28 : #E2E9E4;
    out property <color> heat-1: dark ? #0F3D2A : #BFE8CB;
    out property <color> heat-2: dark ? #17663F : #7CD097;
    out property <color> heat-3: dark ? #23A05A : #2FA25C;
    out property <color> heat-4: dark ? #4BE07A : #17703D;
    out property <string> pixel: "Pixelify Sans";
    out property <string> body: "Geist";
    out property <string> mono: "Geist Mono";

    public pure function tone(name: string) -> color {
        return name == "safe" ? accent : name == "scan" ? signal : name == "warn" ? amber : name == "alarm" ? alarm : name == "oxide" ? oxide : fg-3;
    }
}

export global Assets {
    in property <[PixelDot]> mark-pixels;
    in property <image> wordmark;
    in property <image> i-shield;
    in property <image> i-scan;
    in property <image> i-bug;
    in property <image> i-vault;
    in property <image> i-clock;
    in property <image> i-gear;
    in property <image> i-info;
    in property <image> i-folder;
    in property <image> i-file;
    in property <image> i-bolt;
    in property <image> i-update;
    in property <image> i-disk;
    in property <image> i-trash;
    in property <image> i-check;
    in property <image> i-tasks;
    in property <image> i-sparkle;
    in property <image> i-lock;
    in property <image> i-terminal;
    // 16 × 16 tile with one 2 × 2 dot: the grid the shields keep watch on.
    in property <image> dot-tile;
}

// ---------- type ----------

component Eyebrow inherits Text {
    font-family: Theme.mono;
    font-size: 11px;
    letter-spacing: 1.2px;
    color: Theme.fg-3;
}

component Title inherits Text {
    font-family: Theme.pixel;
    font-size: 28px;
    font-weight: 600;
    color: Theme.fg;
}

component Body inherits Text {
    font-family: Theme.body;
    font-size: 14px;
    color: Theme.fg-2;
    wrap: word-wrap;
}

component Mono inherits Text {
    font-family: Theme.mono;
    font-size: 12px;
    color: Theme.fg-2;
    overflow: elide;
}

// ---------- pixel surfaces ----------

component Edges inherits Rectangle {
    in property <color> edge;
    in property <length> t: 2px;
    Rectangle { x: 0; y: -root.t; width: root.width; height: root.t; background: root.edge; }
    Rectangle { x: 0; y: root.height; width: root.width; height: root.t; background: root.edge; }
    Rectangle { x: -root.t; y: 0; width: root.t; height: root.height; background: root.edge; }
    Rectangle { x: root.width; y: 0; width: root.t; height: root.height; background: root.edge; }
}

// A block with the brand's stepped corners: two 2 px steps.
component Stepped inherits Rectangle {
    in property <color> c;
    Rectangle { x: 4px; y: 0; width: root.width - 8px; height: root.height; background: root.c; }
    Rectangle { x: 2px; y: 2px; width: root.width - 4px; height: root.height - 4px; background: root.c; }
    Rectangle { x: 0; y: 4px; width: root.width; height: root.height - 8px; background: root.c; }
}

// The brand's panel: stepped corners, a 2 px edge, a faint glint along the top, and a hard shadow
// when raised. lit = hovered and clickable: the shadow grows from 0 to 6 px, so the card rises.
component Panel inherits Rectangle {
    in property <color> fill: Theme.surface;
    in property <color> edge: Theme.line;
    in property <bool> raised: false;
    in property <bool> lit: false;
    property <length> sh: root.lit ? 6px : root.raised ? 4px : 0px;
    animate sh { duration: 160ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    if root.sh > 0.5px: Stepped { x: root.sh; y: root.sh; width: root.width; height: root.height; c: Theme.shadow; }
    Stepped { x: 0; y: 0; width: root.width; height: root.height; c: root.edge; }
    Rectangle { x: 4px; y: 2px; width: root.width - 8px; height: root.height - 4px; background: root.fill; animate background { duration: 160ms; } }
    Rectangle { x: 2px; y: 4px; width: root.width - 4px; height: root.height - 8px; background: root.fill; animate background { duration: 160ms; } }
    Rectangle { x: 4px; y: 2px; width: root.width - 8px; height: 2px; background: Theme.glint; }
    @children
}

// The Hexward mark drawn pixel by pixel, so it can assemble, scan and speak.
component PixelMark inherits Rectangle {
    in property <length> size: 96px;
    // brand | safe | scan | warn | alarm
    in property <string> state: "brand";
    // 0 → 1: pixels drop into place row by row.
    in property <float> build: 1;
    // Row being scanned (-1 for none); lights that row and fades the one above.
    in property <int> scan-row: -1;
    in property <bool> blink: false;
    in property <int> frame: 0;
    property <length> u: root.size / 16;
    property <color> core: root.state == "brand" ? Theme.oxide : Theme.tone(root.state);
    property <bool> core-off: root.blink && Math.mod(root.frame, root.state == "alarm" ? 10 : 20) >= (root.state == "alarm" ? 5 : 14);
    width: root.size;
    height: root.size;
    for p in Assets.mark-pixels: Rectangle {
        property <float> k: Math.clamp((root.build * 1.6 - p.y * 0.05 - Math.mod(p.x * 7 + p.y * 3, 5) * 0.03) / 0.3, 0, 1);
        x: p.x * root.u;
        y: p.y * root.u - (1 - self.k) * root.u * 4;
        width: root.u + 0.6px;
        height: root.u + 0.6px;
        opacity: self.k;
        background: p.c == 2 ? (root.core-off ? root.core.with-alpha(0.2) : root.core)
            : p.y == root.scan-row ? Theme.signal
            : p.y == root.scan-row - 1 ? (p.c == 0 ? Theme.mark-hi.mix(Theme.signal, 0.5) : Theme.mark-lo.mix(Theme.signal, 0.5))
            : p.c == 0 ? Theme.mark-hi : Theme.mark-lo;
    }
}

// ---------- controls ----------

component Btn inherits Rectangle {
    in property <string> text;
    // primary | ghost | danger | quiet
    in property <string> kind: "primary";
    in property <bool> enabled: true;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> small: false;
    callback clicked;
    property <bool> down: ta.pressed && root.enabled;
    property <bool> solid: root.kind != "quiet";
    property <color> fill: !root.enabled ? Theme.raised : root.kind == "primary" ? (ta.has-hover ? Theme.accent.brighter(0.08) : Theme.accent) : root.kind == "danger" ? (ta.has-hover ? Theme.alarm.brighter(0.08) : Theme.alarm) : root.kind == "ghost" ? (ta.has-hover ? Theme.raised : Theme.surface) : ta.has-hover ? Theme.raised : transparent;
    property <color> edge: !root.enabled ? Theme.raised : root.kind == "ghost" ? (ta.has-hover ? Theme.fg-3 : Theme.line-strong) : root.kind == "quiet" ? transparent : root.fill;
    property <color> ink: !root.enabled ? Theme.fg-3 : root.kind == "primary" ? Theme.on-accent : root.kind == "danger" ? Theme.bg : Theme.fg;
    property <length> pad: root.small ? 10px : 16px;
    property <length> drop: root.small ? 3px : 4px;
    min-width: label.preferred-width + 2 * root.pad + (root.has-icon ? 24px : 0px);
    min-height: root.small ? 30px : 38px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    // The hard shadow the face sinks into.
    if root.solid && root.enabled && !root.down: Rectangle { x: root.drop; y: root.drop; width: root.width; height: root.height; background: Theme.shadow; }
    Rectangle {
        x: root.down ? root.drop : 0px;
        y: root.down ? root.drop : 0px;
        width: root.width;
        height: root.height;
        background: root.fill;
        animate background { duration: 80ms; }
        Edges { x: 0; y: 0; width: parent.width; height: parent.height; edge: root.edge; }
        if (root.kind == "primary" || root.kind == "danger") && root.enabled: Rectangle {
            x: 0;
            y: root.down ? 0px : parent.height - 3px;
            width: parent.width;
            height: 3px;
            background: #00000038;
        }
        HorizontalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            spacing: 8px;
            alignment: center;
            if root.has-icon: VerticalLayout {
                alignment: center;
                Image { source: root.icon; width: 16px; height: 16px; colorize: root.ink; image-rendering: pixelated; }
            }
            label := Text {
                text: root.text;
                color: root.ink;
                font-family: Theme.body;
                font-size: root.small ? 12px : 13.5px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.fg-2;
    background: root.tone.with-alpha(0.14);
    width: t.preferred-width + 28px;
    height: 22px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    Rectangle { x: 8px; y: (parent.height - 6px) / 2; width: 6px; height: 6px; background: root.tone; }
    t := Text {
        x: 20px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: root.tone;
        font-family: Theme.mono;
        font-size: 11px;
        letter-spacing: 0.6px;
    }
}

component Switch inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);
    width: 44px;
    height: 24px;
    background: root.checked ? Theme.heat-1 : Theme.raised;
    Edges { x: 0; y: 0; width: root.width; height: root.height; edge: root.checked ? Theme.accent : Theme.line-strong; }
    Rectangle {
        x: root.checked ? 24px : 4px;
        y: 4px;
        width: 16px;
        height: 16px;
        background: root.checked ? Theme.accent : Theme.fg-3;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

component Check inherits Rectangle {
    in property <bool> checked;
    callback toggled;
    width: 20px;
    height: 20px;
    background: root.checked ? Theme.accent : Theme.bg;
    Edges { x: 0; y: 0; width: root.width; height: root.height; edge: root.checked ? Theme.accent : Theme.line-strong; }
    if root.checked: Image { x: 2px; y: 2px; width: 16px; height: 16px; source: Assets.i-check; colorize: Theme.on-accent; image-rendering: pixelated; }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

// 20 whole blocks. value 0..1, or below 0 while the total is still being counted.
component Blocks inherits Rectangle {
    in property <float> value;
    in property <int> frame;
    height: 18px;
    property <int> sweep: Math.mod(Math.floor(root.frame / 2), 26) - 3;
    for i in 20: Rectangle {
        x: i * ((root.width - 19 * 4px) / 20 + 4px);
        y: 0;
        width: (root.width - 19 * 4px) / 20;
        height: root.height;
        background: root.value >= 0
            ? (i < Math.floor(root.value * 20 + 0.001) ? Theme.accent : i == Math.floor(root.value * 20 + 0.001) && Math.mod(root.frame, 8) < 4 && root.value < 1 ? Theme.accent.with-alpha(0.45) : Theme.raised)
            : (i <= root.sweep && i > root.sweep - 4 ? Theme.signal.with-alpha(1 - (root.sweep - i) * 0.28) : Theme.raised);
    }
}

component PixelSpinner inherits Rectangle {
    in property <int> frame;
    in property <color> tone: Theme.accent;
    width: 26px;
    height: 26px;
    property <int> step: Math.mod(root.frame, 8);
    for i in 9: Rectangle {
        // ring order around a 3 × 3 grid, center left empty
        property <int> order: i == 0 ? 0 : i == 1 ? 1 : i == 2 ? 2 : i == 5 ? 3 : i == 8 ? 4 : i == 7 ? 5 : i == 6 ? 6 : i == 3 ? 7 : -1;
        x: Math.mod(i, 3) * 9px;
        y: Math.floor(i / 3) * 9px;
        width: 8px;
        height: 8px;
        visible: self.order >= 0;
        background: self.order == root.step ? root.tone : Math.mod(root.step - self.order + 8, 8) == 1 ? root.tone.with-alpha(0.5) : Theme.raised;
    }
}

component Stat inherits Panel {
    in property <string> label;
    in property <string> value;
    in property <color> tone: Theme.fg;
    in property <bool> big: true;
    in property <string> sub;
    in property <color> led: transparent;
    VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 3px;
        HorizontalLayout {
            spacing: 6px;
            if root.led != transparent: VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; background: root.led; } }
            Eyebrow { text: root.label; font-size: 10px; overflow: elide; }
        }
        Text {
            text: root.value;
            font-family: root.big ? Theme.pixel : Theme.mono;
            font-size: root.big ? 22px : 14px;
            font-weight: 600;
            color: root.tone;
            overflow: elide;
            animate color { duration: 200ms; }
        }
        if root.sub != "": Mono { text: root.sub; font-size: 10.5px; color: Theme.fg-3; }
    }
}

// A panel's own heading: small, bold, with room for a note on the right.
component PanelHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> note;
    spacing: 8px;
    Text { text: root.title; font-family: Theme.body; font-size: 13px; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
    Rectangle { horizontal-stretch: 1; }
    Mono { text: root.note; color: Theme.fg-3; font-size: 11px; vertical-alignment: center; }
}

// Live throughput: one pixel bar per sample, newest on the right and brightest.
component Spark inherits Rectangle {
    in property <[float]> values;
    in property <color> tone: Theme.signal;
    property <length> bw: root.width / 60;
    for v[i] in root.values: Rectangle {
        x: root.width - (root.values.length - i) * root.bw;
        y: root.height - self.height;
        width: Math.max(1px, root.bw - 2px);
        height: Math.max(2px, Math.round(v * root.height / 2px) * 2px);
        background: i == root.values.length - 1 ? root.tone : root.tone.with-alpha(0.25 + 0.4 * i / Math.max(1, root.values.length));
    }
    Rectangle { x: 0; y: root.height - 1px; width: root.width; height: 1px; background: Theme.line; }
}

// The scan HUD: a small shield sending out square pixel rings while it reads.
component Radar inherits Rectangle {
    in property <int> frame;
    in property <bool> active;
    in property <string> state: "scan";
    property <length> cx: self.width / 2;
    property <length> cy: self.height / 2;
    clip: true;
    for k in 3: Rectangle {
        property <float> t: Math.mod(root.frame + k * 16, 48) / 48;
        property <length> side: Math.round((64px + self.t * (root.height - 64px)) / 4px) * 4px;
        x: Math.round((root.cx - self.side / 2) / 2px) * 2px;
        y: Math.round((root.cy - self.side / 2) / 2px) * 2px;
        width: self.side;
        height: self.side;
        visible: root.active;
        opacity: (1 - self.t) * 0.8;
        border-width: 2px;
        border-color: Theme.tone(root.state);
    }
    // corner brackets: the HUD frame
    for c in 4: Rectangle {
        x: Math.mod(c, 2) == 0 ? 0px : root.width - 12px;
        y: c < 2 ? 0px : root.height - 12px;
        width: 12px;
        height: 12px;
        Rectangle { x: Math.mod(c, 2) == 0 ? 0px : 10px; y: 0; width: 2px; height: 12px; background: Theme.line-strong; }
        Rectangle { x: 0; y: c < 2 ? 0px : 10px; width: 12px; height: 2px; background: Theme.line-strong; }
    }
    PixelMark {
        x: root.cx - 28px;
        y: root.cy - 28px;
        size: 56px;
        state: root.state;
        blink: root.active;
        scan-row: root.active ? Math.mod(Math.floor(root.frame / 2), 20) - 2 : -1;
        frame: root.frame;
    }
}

// A dashboard shortcut: icon and label, rises on hover.
component Shortcut inherits Panel {
    in property <image> icon;
    in property <string> text;
    in property <string> hint;
    callback clicked;
    lit: ta.has-hover;
    edge: ta.has-hover ? Theme.accent : Theme.line;
    fill: ta.has-hover ? Theme.raised : Theme.surface;
    height: 44px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout { alignment: center; Image { source: root.icon; width: 18px; height: 18px; colorize: ta.has-hover ? Theme.accent : Theme.fg-2; image-rendering: pixelated; } }
        Text { text: root.text; font-family: Theme.body; font-size: 12.5px; font-weight: 600; color: Theme.fg; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Mono { text: root.hint; font-size: 10px; color: Theme.fg-3; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// One toast: as tall as its text, springs in from the right, a threat shakes once, the countdown
// blocks drain (paused while hovered).
component ToastCard inherits Rectangle {
    in property <ToastItem> item;
    in property <int> frame;
    callback dismiss;
    callback act;
    callback hover(bool);
    property <bool> shown: false;
    property <int> born: 0;
    property <int> age: root.frame - root.born;
    property <color> tone: Theme.tone(root.item.state);
    property <length> shake: root.item.state == "alarm" && root.age >= 7 && root.age < 19 ? (Math.mod(root.age, 4) < 2 ? -4px : 4px) : 0px;
    property <length> off: (root.shown ? 0px : 64px) + root.shake;
    animate off { duration: 260ms; easing: cubic-bezier(0.3, 1.4, 0.5, 1); }
    height: body.preferred-height;
    init => {
        self.born = root.frame;
        self.shown = true;
    }
    ta := TouchArea {
        changed has-hover => {
            root.hover(self.has-hover);
        }
    }
    Panel {
        x: root.off;
        y: 0;
        width: root.width;
        height: root.height;
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: 160ms; }
        raised: true;
        edge: root.tone.with-alpha(0.75);
        Rectangle { x: 4px; y: 6px; width: 4px; height: parent.height - 12px; background: root.tone; }
        if root.item.life >= 0: Rectangle {
            x: 14px;
            y: parent.height - 9px;
            width: parent.width - 28px;
            height: 3px;
            for i in 12: Rectangle {
                x: i * (parent.width / 12);
                width: parent.width / 12 - 2px;
                height: 3px;
                background: root.tone;
                opacity: i < Math.ceil(root.item.life * 12) ? 0.85 : 0.15;
            }
        }
    }
    body := HorizontalLayout {
        x: root.off;
        padding: 14px;
        padding-left: 20px;
        padding-bottom: root.item.life >= 0 ? 18px : 14px;
        spacing: 12px;
        VerticalLayout { alignment: start; PixelMark { size: 28px; state: root.item.state; } }
        VerticalLayout {
            spacing: 3px;
            alignment: start;
            horizontal-stretch: 1;
            Text { text: root.item.title; font-family: Theme.body; font-size: 13.5px; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
            Body { text: root.item.text; font-size: 12px; }
            if root.item.action != "": HorizontalLayout {
                padding-top: 8px;
                alignment: start;
                Btn { text: root.item.action; small: true; kind: root.item.state == "alarm" ? "danger" : "primary"; clicked => { root.act(); } }
            }
        }
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 20px;
                height: 20px;
                background: x-ta.has-hover ? Theme.raised : transparent;
                Path { x: 5px; y: 5px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; commands: "M 0 0 L 10 10 M 10 0 L 0 10"; stroke: Theme.fg-3; stroke-width: 2px; }
                x-ta := TouchArea { mouse-cursor: pointer; clicked => { root.dismiss(); } }
            }
        }
    }
}

component Heat inherits Rectangle {
    in property <[int]> cells;
    in property <length> cell: 11px;
    in property <length> gap: 3px;
    width: Math.ceil(root.cells.length / 7) * (root.cell + root.gap) - root.gap;
    height: 7 * (root.cell + root.gap) - root.gap;
    for v[i] in root.cells: Rectangle {
        x: Math.floor(i / 7) * (root.cell + root.gap);
        y: Math.mod(i, 7) * (root.cell + root.gap);
        width: root.cell;
        height: root.cell;
        visible: v >= 0;
        background: v == 5 ? Theme.alarm : v == 4 ? Theme.heat-4 : v == 3 ? Theme.heat-3 : v == 2 ? Theme.heat-2 : v == 1 ? Theme.heat-1 : Theme.heat-0;
    }
}

component Legend inherits HorizontalLayout {
    spacing: 4px;
    alignment: start;
    Mono { text: "Less "; color: Theme.fg-3; vertical-alignment: center; }
    for c in [Theme.heat-0, Theme.heat-1, Theme.heat-2, Theme.heat-3, Theme.heat-4]: VerticalLayout {
        alignment: center;
        Rectangle { width: 10px; height: 10px; background: c; }
    }
    Mono { text: " More      "; color: Theme.fg-3; vertical-alignment: center; }
    VerticalLayout {
        alignment: center;
        Rectangle { width: 10px; height: 10px; background: Theme.alarm; }
    }
    Mono { text: " Threat found"; color: Theme.fg-3; vertical-alignment: center; }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <string> badge;
    in property <color> badge-tone: Theme.alarm;
    callback clicked;
    height: 40px;
    background: root.active ? Theme.raised : ta.has-hover ? Theme.raised.with-alpha(0.55) : transparent;
    animate background { duration: 120ms; }
    Rectangle {
        x: 0;
        y: 0;
        width: root.active ? 3px : 0px;
        height: root.height;
        background: Theme.accent;
        animate width { duration: 120ms; }
    }
    Image {
        x: 18px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.active ? Theme.accent : Theme.fg-2;
        image-rendering: pixelated;
    }
    Text {
        x: 48px;
        y: 0;
        height: parent.height;
        vertical-alignment: center;
        text: root.text;
        color: root.active ? Theme.fg : Theme.fg-2;
        font-family: Theme.body;
        font-size: 13px;
        font-weight: root.active ? 600 : 500;
    }
    if root.badge != "": Chip {
        x: parent.width - self.width - 12px;
        y: (parent.height - self.height) / 2;
        text: root.badge;
        tone: root.badge-tone;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Seg inherits HorizontalLayout {
    in property <[string]> options;
    in property <string> value;
    callback picked(string);
    spacing: 8px;
    alignment: end;
    for o in root.options: Btn {
        text: o;
        small: true;
        kind: o == root.value ? "primary" : "ghost";
        clicked => {
            root.picked(o);
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <bool> last: false;
    min-height: 70px;
    HorizontalLayout {
        padding: 16px;
        padding-left: 18px;
        spacing: 24px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text { text: root.title; font-family: Theme.body; font-size: 14px; font-weight: 600; color: Theme.fg; }
            Body { text: root.text; font-size: 13px; }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
    if !root.last: Rectangle { x: 0; y: parent.height - 2px; width: parent.width; height: 2px; background: Theme.line; }
}

component SearchBox inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Search";
    callback edited();
    width: 220px;
    height: 30px;
    background: Theme.bg;
    Edges { x: 0; y: 0; width: root.width; height: root.height; edge: ti.has-focus ? Theme.accent : Theme.line-strong; }
    Image { x: 9px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; source: Assets.i-scan; colorize: Theme.fg-3; image-rendering: pixelated; }
    if root.text == "": Text {
        x: 30px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.fg-3;
        font-family: Theme.body;
        font-size: 13px;
    }
    ti := TextInput {
        x: 30px;
        width: parent.width - 38px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        font-family: Theme.body;
        font-size: 13px;
        color: Theme.fg;
        selection-background-color: Theme.accent.with-alpha(0.35);
        edited => {
            root.edited();
        }
    }
}

// A thin usage bar: 0..1.
component Meter inherits Rectangle {
    in property <float> value;
    in property <color> tone: Theme.heat-3;
    height: 6px;
    background: Theme.raised;
    Rectangle { x: 0; width: parent.width * Math.clamp(root.value, 0, 1); height: parent.height; background: root.tone; animate width { duration: 300ms; } }
}

component Header inherits VerticalLayout {
    in property <string> eyebrow;
    in property <string> title;
    in property <string> text;
    spacing: 6px;
    Eyebrow { text: root.eyebrow; }
    Title { text: root.title; }
    if root.text != "": Body { text: root.text; }
}

component Empty inherits Panel {
    in property <image> icon;
    in property <string> title;
    in property <string> text;
    height: 190px;
    Rectangle {
        // dot dither, the brand's one texture
        for i in 120: Rectangle {
            x: Math.mod(i, 20) * (root.width / 20) + 6px;
            y: Math.floor(i / 20) * (root.height / 6) + 10px;
            width: 2px;
            height: 2px;
            background: Theme.line;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Image { source: root.icon; width: 40px; height: 40px; colorize: Theme.fg-3; image-rendering: pixelated; }
        }
        Text { text: root.title; horizontal-alignment: center; font-family: Theme.body; font-size: 15px; font-weight: 600; color: Theme.fg; }
        Text { text: root.text; horizontal-alignment: center; font-family: Theme.body; font-size: 13px; color: Theme.fg-3; }
    }
}

// Slides and fades a screen in when it appears.
component Screen inherits Rectangle {
    property <bool> shown: false;
    y: self.shown ? 0px : 12px;
    opacity: self.shown ? 1 : 0;
    animate y { duration: 220ms; easing: ease-out; }
    animate opacity { duration: 180ms; }
    init => {
        self.shown = true;
    }
    @children
}

component ScanCard inherits Panel {
    in property <image> icon;
    in property <string> title;
    in property <string> text;
    in property <string> meta;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;
    fill: root.selected ? Theme.raised : ta.has-hover && root.enabled ? Theme.raised.with-alpha(0.6) : Theme.surface;
    edge: root.selected ? Theme.accent : ta.has-hover && root.enabled ? Theme.line-strong : Theme.line;
    raised: root.selected;
    min-height: 132px;
    VerticalLayout {
        padding: 18px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Image { source: root.icon; width: 24px; height: 24px; colorize: root.selected ? Theme.accent : Theme.fg-2; image-rendering: pixelated; }
            Text { text: root.title; font-family: Theme.pixel; font-size: 20px; color: Theme.fg; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Mono { text: root.meta; color: Theme.fg-3; font-size: 11px; vertical-alignment: center; }
        }
        Body { text: root.text; font-size: 13px; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

component WinButton inherits Rectangle {
    // min | max | close
    in property <string> kind;
    in property <bool> is-max;
    callback clicked;
    width: 46px;
    background: ta.has-hover ? (root.kind == "close" ? Theme.alarm : Theme.raised) : transparent;
    property <color> ink: ta.has-hover && root.kind == "close" ? #FFFFFF : Theme.fg-2;
    if root.kind == "min": Rectangle { x: (parent.width - 10px) / 2; y: parent.height / 2; width: 10px; height: 2px; background: root.ink; }
    if root.kind == "max" && !root.is-max: Rectangle {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        border-width: 2px;
        border-color: root.ink;
    }
    if root.kind == "max" && root.is-max: Rectangle {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        Rectangle { x: 2px; y: 0; width: 8px; height: 8px; border-width: 2px; border-color: root.ink; }
        Rectangle { x: 0; y: 3px; width: 8px; height: 7px; border-width: 2px; border-color: root.ink; background: ta.has-hover ? Theme.raised : Theme.surface; }
    }
    if root.kind == "close": Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
        stroke: root.ink;
        stroke-width: 2px;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component ResizeEdge inherits TouchArea {
    in property <string> dir;
    callback resize(string);
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.resize(root.dir);
        }
    }
}

// ---------- the window ----------

export component AppWindow inherits Window {
    title: "Hexward";
    icon: root.app-icon;
    no-frame: true;
    preferred-width: 1240px;
    preferred-height: 800px;
    min-width: 1000px;
    min-height: 680px;
    background: Theme.bg;
    default-font-family: Theme.body;

    in property <image> app-icon;
    in property <string> version;
    in-out property <string> page: "home";
    in property <bool> is-max;
    in property <bool> engine-ready;
    in property <string> engine-status: "Loading rules…";
    in property <string> rules-count: "…";
    in property <bool> needs-rules;

    // Motion
    in-out property <int> frame;
    in-out property <float> boot: 0;
    in property <bool> flash;
    animate boot { duration: 1500ms; easing: linear; }

    // Home
    in property <string> home-state: "warn";
    in property <string> home-chip: "NOT SCANNED YET";
    in property <string> home-title: "No scan yet";
    in property <string> home-text;
    in property <[StatItem]> home-stats;
    in property <[StatusRow]> status-rows;
    in property <[int]> heat-short;
    in property <[int]> heat-year;

    // Scan
    in-out property <string> scan-choice: "quick";
    in property <[DriveRow]> drives;
    in property <[string]> folders;
    in property <bool> scanning;
    in property <bool> paused;
    in property <bool> scan-started;
    in property <string> scan-kind: "QUICK SCAN";
    in property <string> scan-title;
    in property <string> scan-text;
    in property <string> scan-path;
    in property <string> scan-bytes;
    in property <string> scan-files: "0";
    in property <int> scan-threats;
    in property <string> scan-speed: "0";
    in property <string> scan-time: "0:00";
    in property <float> scan-fraction: -1;
    in property <[int]> grid-cells;

    // Results
    in property <[ThreatRow]> threats;
    in property <string> results-title: "No results yet";
    in property <string> results-text: "Run a scan and anything it finds shows up here.";
    in property <int> selected-count;
    in property <int> open-count;

    // Startup
    in property <[StartupRow]> startup-rows;
    in property <[DisabledRow]> disabled-rows;
    in property <string> startup-summary;
    in property <bool> startup-busy;
    in property <bool> startup-checked;
    in property <bool> startup-show-all;
    in-out property <string> startup-search;
    in-out property <string> startup-sort: "Problems";

    // Tasks
    in property <[TaskRow]> tasks;
    in-out property <string> tasks-group: "apps";
    in-out property <string> tasks-search;
    in-out property <string> tasks-sort: "Name";
    in property <int> tasks-n-apps;
    in property <int> tasks-n-background;
    in property <int> tasks-n-windows;
    in property <int> tasks-risky;
    in property <string> tasks-cpu: "…";
    in property <string> tasks-mem: "…";
    in property <bool> tasks-loading: true;
    in property <bool> tasks-scanning;
    in property <bool> tasks-memory-busy;

    // Dev & AI
    in-out property <string> dev-tab: "audit";
    in-out property <string> audit-target;
    in-out property <bool> audit-online;
    in-out property <bool> audit-history: true;
    in-out property <bool> audit-show-info;
    in property <bool> audit-busy;
    in property <bool> audit-done;
    in property <string> audit-status;
    in property <string> audit-summary;
    in property <string> audit-state: "safe";
    in property <[AuditRow]> audit-rows;
    in property <bool> guard-installed;
    in property <[GuardRow]> guard-rows;
    in property <[McpRow]> mcp-rows;
    in property <int> mcp-waiting;
    in property <[ExtRow]> ext-rows;
    in property <string> ext-summary;
    in property <bool> ext-busy;
    in property <bool> ext-loaded;

    // Cleaner
    in property <[CleanGroup]> cleaner-groups;
    in property <bool> cleaner-busy;
    in property <bool> cleaner-analyzed;
    in property <string> cleaner-status;
    in property <string> cleaner-selected: "0 B";
    in property <string> cleaner-found: "…";
    in property <bool> cleaner-has-selection;
    in property <int> cleaner-browsers;
    in property <string> cleaner-blocked;
    in-out property <bool> cleaner-confirm;

    // Quarantine, history, allow list
    in property <[VaultRow]> vault-rows;
    in property <[EventRow]> events;
    in property <[AllowRow]> allow-rows;

    // Settings
    in property <int> max-size-mb: 64;
    in property <bool> quarantine-suspicious;
    in property <bool> close-to-tray: true;
    in property <bool> start-with-windows: true;
    in property <bool> quiet-mode: true;
    in property <bool> script-shield;
    in property <bool> ransomware-shield: true;
    in property <bool> cloud-reputation: false;
    in property <bool> cloud-reports: false;
    in property <bool> cloud-samples: false;
    in property <bool> cloud-counts: false;
    in property <bool> document-backup: true;
    in property <bool> script-shield-busy;
    in property <bool> file-shield: true;
    in property <bool> process-shield: true;
    in property <bool> auto-quarantine: true;
    in property <bool> clickfix-shield: true;
    in property <bool> stealer-shield: true;
    in property <string> shield-info;
    in property <string> pack: "core";
    in property <bool> updating;
    in property <string> rules-info;
    in property <string> bazaar-info;
    in property <string> data-dir;

    // App updates
    in property <bool> app-update-available;
    in property <string> app-update-version;
    in property <string> app-update-notes;
    in property <bool> app-update-busy;
    in property <string> app-update-status;

    // Toast
    in property <[ToastItem]> toasts;
    // True for a moment after a threat toast arrives, so the frame clock runs its shake.
    in property <bool> toast-fresh;
    callback toast-dismiss(int);
    callback toast-act(int);
    callback toast-hover(int, bool);
    in property <[EventRow]> home-events;
    in property <string> shields-on: "…";
    in property <[float]> scan-speed-history;

    callback navigate(string);
    callback start-scan(string);
    callback pause-scan();
    callback stop-scan();
    callback toggle-drive(int);
    callback add-folder();
    callback remove-folder(int);
    callback toggle-threat(int);
    callback quarantine-selected();
    callback quarantine-one(int);
    callback ask-delete(int);
    callback cancel-delete(int);
    callback delete-one(int);
    callback allow-one(int);
    callback check-startup();
    callback set-show-all(bool);
    callback startup-changed();
    callback disable-startup(int);
    callback restore-startup(string);
    callback audit-pick();
    callback audit-run();
    callback audit-reshow();
    callback audit-open(string);
    callback guard-toggle(bool);
    callback mcp-approve(string);
    callback ext-refresh();
    callback dev-tab-changed(string);
    callback cleaner-analyze();
    callback cleaner-toggle(string);
    callback cleaner-clean();
    callback cleaner-close-browser(string);
    callback tasks-changed();
    callback task-ask-end(int);
    callback task-end(int);
    callback task-scan(string);
    callback task-open(string);
    callback tasks-scan-memory();
    callback vault-restore(string);
    callback vault-ask(int);
    callback vault-cancel(int);
    callback vault-delete(string);
    callback allow-remove(string);
    callback update-rules();
    callback set-dark(bool);
    callback set-max-size(string);
    callback set-quarantine-suspicious(bool);
    callback set-close-to-tray(bool);
    callback set-start-with-windows(bool);
    callback set-quiet-mode(bool);
    callback set-script-shield(bool);
    callback set-ransomware-shield(bool);
    callback set-cloud-reputation(bool);
    callback set-cloud-reports(bool);
    callback set-cloud-samples(bool);
    callback set-cloud-counts(bool);
    callback send-sample(int);
    callback set-document-backup(bool);
    callback restore-files();
    callback set-file-shield(bool);
    callback set-process-shield(bool);
    callback set-auto-quarantine(bool);
    callback set-clickfix-shield(bool);
    callback set-stealer-shield(bool);
    callback set-pack(string);
    callback open-data-dir();
    callback check-app-update();
    callback install-app-update();
    callback drag-window();
    callback resize-window(string);
    callback minimize-window();
    callback toggle-maximize();
    callback close-window();

    property <bool> moving: root.toast-fresh || root.scanning || root.boot < 1 || root.flash || root.startup-busy || root.updating || root.app-update-busy || root.home-state == "alarm" || root.tasks-scanning || root.tasks-memory-busy || (root.page == "tasks" && root.tasks-loading) || root.cleaner-busy || root.audit-busy || root.ext-busy;
    Timer {
        interval: 33ms;
        running: root.moving;
        triggered => {
            root.frame += 1;
        }
    }
    // The idle heartbeat: two blinks of the core every 4 seconds while protected.
    property <int> beat;
    Timer {
        interval: 200ms;
        running: !root.moving && root.page == "home";
        triggered => {
            root.beat = Math.mod(root.beat + 1, 20);
        }
    }
    init => {
        root.boot = 1;
    }

    function go(p: string) {
        root.page = p;
        root.navigate(p);
    }

    property <string> page-name: root.page == "home" ? "HOME" : root.page == "scan" ? "SCAN" : root.page == "results" ? "RESULTS" : root.page == "startup" ? "STARTUP" : root.page == "tasks" ? "TASKS" : root.page == "cleaner" ? "CLEANER" : root.page == "dev" ? "DEV & AI" : root.page == "vault" ? "QUARANTINE" : root.page == "history" ? "HISTORY" : root.page == "settings" ? "SETTINGS" : "ABOUT";

    VerticalLayout {
        // ---------- title bar ----------
        Rectangle {
            height: 46px;
            background: Theme.surface;
            HorizontalLayout {
                Rectangle {
                    width: 232px;
                    HorizontalLayout {
                        padding-left: 18px;
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            PixelMark { size: 26px; build: root.boot; state: root.scanning ? "scan" : "brand"; blink: root.scanning && !root.paused; frame: root.frame; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Image { source: Assets.wordmark; height: 14px; width: 82px; colorize: Theme.fg; image-rendering: pixelated; }
                        }
                    }
                    TouchArea {
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                root.drag-window();
                            }
                        }
                        double-clicked => { root.toggle-maximize(); }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    TouchArea {
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                root.drag-window();
                            }
                        }
                        double-clicked => { root.toggle-maximize(); }
                    }
                    HorizontalLayout {
                        padding-left: 26px;
                        spacing: 12px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Eyebrow { text: root.page-name; color: Theme.fg-2; }
                        }
                        if root.scanning: VerticalLayout {
                            alignment: center;
                            Chip { text: root.paused ? "PAUSED" : "SCANNING · " + root.scan-files; tone: Theme.signal; }
                        }
                    }
                }
                if root.app-update-available: VerticalLayout {
                    alignment: center;
                    padding-right: 10px;
                    Btn {
                        text: root.app-update-busy ? "Updating…" : "Update to " + root.app-update-version;
                        small: true;
                        enabled: !root.app-update-busy;
                        has-icon: true;
                        icon: Assets.i-update;
                        clicked => { root.install-app-update(); }
                    }
                }
                WinButton { kind: "min"; clicked => { root.minimize-window(); } }
                WinButton { kind: "max"; is-max: root.is-max; clicked => { root.toggle-maximize(); } }
                WinButton { kind: "close"; clicked => { root.close-window(); } }
            }
            Rectangle { x: 0; y: parent.height - 2px; width: parent.width; height: 2px; background: Theme.line; }
        }

        HorizontalLayout {
            // ---------- sidebar ----------
            Rectangle {
                width: 232px;
                background: Theme.surface;
                VerticalLayout {
                    padding-top: 16px;
                    padding-bottom: 14px;
                    spacing: 2px;
                    NavItem { text: "Home"; icon: Assets.i-shield; active: root.page == "home"; clicked => { root.go("home"); } }
                    NavItem {
                        text: "Scan";
                        icon: Assets.i-scan;
                        active: root.page == "scan";
                        badge: root.scanning ? (root.scan-fraction >= 0 ? Math.floor(root.scan-fraction * 100) + "%" : "…") : "";
                        badge-tone: Theme.signal;
                        clicked => { root.go("scan"); }
                    }
                    NavItem { text: "Results"; icon: Assets.i-bug; active: root.page == "results"; badge: root.open-count > 0 ? root.open-count : ""; clicked => { root.go("results"); } }
                    NavItem { text: "Startup"; icon: Assets.i-bolt; active: root.page == "startup"; clicked => { root.go("startup"); } }
                    NavItem { text: "Dev & AI"; icon: Assets.i-terminal; active: root.page == "dev"; badge: root.mcp-waiting > 0 ? root.mcp-waiting : ""; badge-tone: Theme.amber; clicked => { root.go("dev"); } }
                    NavItem { text: "Cleaner"; icon: Assets.i-sparkle; active: root.page == "cleaner"; clicked => { root.go("cleaner"); } }
                    NavItem { text: "Tasks"; icon: Assets.i-tasks; active: root.page == "tasks"; badge: root.tasks-risky > 0 ? root.tasks-risky : ""; badge-tone: Theme.amber; clicked => { root.go("tasks"); } }
                    NavItem { text: "Quarantine"; icon: Assets.i-vault; active: root.page == "vault"; badge: root.vault-rows.length > 0 ? root.vault-rows.length : ""; badge-tone: Theme.fg-3; clicked => { root.go("vault"); } }
                    NavItem { text: "History"; icon: Assets.i-clock; active: root.page == "history"; clicked => { root.go("history"); } }
                    Rectangle { vertical-stretch: 1; }
                    NavItem { text: "Settings"; icon: Assets.i-gear; active: root.page == "settings"; clicked => { root.go("settings"); } }
                    NavItem { text: "About"; icon: Assets.i-info; active: root.page == "about"; badge: root.app-update-available ? "NEW" : ""; badge-tone: Theme.accent; clicked => { root.go("about"); } }
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-top: 14px;
                        spacing: 8px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                background: root.engine-ready ? Theme.accent : Theme.amber;
                                opacity: root.engine-ready || Math.mod(root.frame, 16) < 10 ? 1 : 0.3;
                            }
                        }
                        Mono { text: root.engine-status; font-size: 11px; color: Theme.fg-3; }
                    }
                }
            }
            Rectangle { width: 2px; background: Theme.line; }

            // ---------- screens ----------
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                Image {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    source: Assets.dot-tile;
                    horizontal-tiling: repeat;
                    vertical-tiling: repeat;
                    colorize: Theme.dot;
                }

                // HOME: status strip, six numbers, every shield, threat map, activity, shortcuts.
                if root.page == "home": Screen {
                    ScrollView {
                        VerticalLayout {
                            padding: 24px;
                            padding-top: 20px;
                            spacing: 14px;
                            alignment: start;
                            if root.app-update-available: Panel {
                                edge: Theme.accent;
                                HorizontalLayout {
                                    padding: 10px;
                                    padding-left: 16px;
                                    spacing: 12px;
                                    VerticalLayout { alignment: center; Chip { text: "UPDATE"; tone: Theme.accent; } }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: "Hexward " + root.app-update-version + " is ready"; font-family: Theme.body; font-size: 13px; font-weight: 600; color: Theme.fg; }
                                        Mono { text: root.app-update-notes; color: Theme.fg-3; font-size: 11px; }
                                    }
                                    Btn { text: root.app-update-busy ? "Updating…" : "Update and restart"; enabled: !root.app-update-busy; small: true; clicked => { root.install-app-update(); } }
                                }
                            }
                            // status strip
                            Panel {
                                raised: true;
                                edge: root.home-state == "alarm" ? Theme.alarm : root.home-state == "warn" ? Theme.amber.with-alpha(0.7) : Theme.line-strong;
                                HorizontalLayout {
                                    padding: 16px;
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    spacing: 20px;
                                    VerticalLayout {
                                        alignment: center;
                                        PixelMark {
                                            size: 64px;
                                            build: root.boot;
                                            state: root.home-state;
                                            blink: root.home-state == "alarm" || (root.home-state == "safe" && !root.moving);
                                            frame: root.home-state == "alarm" ? root.frame : root.beat;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 5px;
                                        horizontal-stretch: 1;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            Chip { text: root.home-chip; tone: Theme.tone(root.home-state); }
                                            Mono { text: "v" + root.version + " · " + root.shields-on + " shields on"; color: Theme.fg-3; font-size: 11px; vertical-alignment: center; }
                                        }
                                        Text { text: root.home-title; font-family: Theme.pixel; font-size: 26px; font-weight: 600; color: Theme.fg; }
                                        Body { text: root.home-text; font-size: 13px; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 10px;
                                        Btn { text: "Quick scan"; has-icon: true; icon: Assets.i-scan; enabled: root.engine-ready && !root.scanning; clicked => { root.go("scan"); root.start-scan("quick"); } }
                                        if root.needs-rules: Btn { text: root.updating ? "Downloading…" : "Get rules"; kind: "ghost"; small: true; enabled: !root.updating; clicked => { root.update-rules(); } }
                                        if !root.needs-rules: Btn { text: "More scans"; kind: "ghost"; small: true; clicked => { root.go("scan"); } }
                                    }
                                }
                            }
                            // numbers
                            HorizontalLayout {
                                spacing: 12px;
                                for s in root.home-stats: Stat {
                                    label: s.label;
                                    value: s.value;
                                    sub: s.sub;
                                    led: s.tone == "" ? transparent : Theme.tone(s.tone);
                                    tone: s.tone == "alarm" ? Theme.alarm : Theme.fg;
                                }
                            }
                            // every shield, and the threat map
                            HorizontalLayout {
                                spacing: 12px;
                                Panel {
                                    horizontal-stretch: 3;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        PanelHead { title: "Protection"; note: root.shields-on + " shields on"; }
                                        Rectangle {
                                            height: Math.ceil(root.status-rows.length / 2) * 44px - 4px;
                                            for r[i] in root.status-rows: Rectangle {
                                                x: Math.mod(i, 2) * (parent.width / 2 + 2px);
                                                y: Math.floor(i / 2) * 44px;
                                                width: parent.width / 2 - 2px;
                                                height: 40px;
                                                background: Theme.raised.with-alpha(0.55);
                                                Rectangle { x: 0; y: 0; width: 2px; height: parent.height; background: Theme.tone(r.tone); }
                                                Rectangle { x: 12px; y: 10px; width: 6px; height: 6px; background: Theme.tone(r.tone); }
                                                Text { x: 26px; y: 5px; width: parent.width - 34px; text: r.name; font-family: Theme.body; font-size: 12.5px; font-weight: 600; color: Theme.fg; overflow: elide; }
                                                Mono { x: 26px; y: 22px; width: parent.width - 34px; text: r.value; font-size: 10.5px; color: Theme.fg-3; }
                                            }
                                        }
                                    }
                                }
                                Panel {
                                    horizontal-stretch: 2;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        alignment: start;
                                        PanelHead { title: "Threat map"; note: "26 weeks"; }
                                        Heat { cells: root.heat-short; cell: 9px; gap: 3px; }
                                        Legend { }
                                    }
                                }
                            }
                            // activity, and shortcuts
                            HorizontalLayout {
                                spacing: 12px;
                                Panel {
                                    horizontal-stretch: 3;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 6px;
                                        alignment: start;
                                        HorizontalLayout {
                                            PanelHead { title: "Recent activity"; note: ""; }
                                            Btn { text: "All history"; kind: "quiet"; small: true; clicked => { root.go("history"); } }
                                        }
                                        if root.home-events.length == 0: Mono { text: "Nothing yet. Scans, shield alerts and fixes appear here."; color: Theme.fg-3; }
                                        for e in root.home-events: HorizontalLayout {
                                            spacing: 10px;
                                            height: 26px;
                                            Mono { text: e.when; width: 96px; color: Theme.fg-3; font-size: 11px; vertical-alignment: center; }
                                            VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; background: Theme.tone(e.tone); } }
                                            Text { text: e.title; font-family: Theme.body; font-size: 12.5px; color: Theme.fg; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                            Mono { text: e.chip; color: Theme.tone(e.tone); font-size: 10px; vertical-alignment: center; }
                                        }
                                    }
                                }
                                Panel {
                                    horizontal-stretch: 2;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        alignment: start;
                                        PanelHead { title: "Shortcuts"; note: ""; }
                                        GridLayout {
                                            spacing: 8px;
                                            Row {
                                                Shortcut { icon: Assets.i-disk; text: "Full scan"; hint: "30+ MIN"; clicked => { root.go("scan"); root.scan-choice = "full"; } }
                                                Shortcut { icon: Assets.i-bolt; text: "Startup"; hint: "AUTORUNS"; clicked => { root.go("startup"); } }
                                            }
                                            Row {
                                                Shortcut { icon: Assets.i-tasks; text: "Tasks"; hint: "MEMORY"; clicked => { root.go("tasks"); } }
                                                Shortcut { icon: Assets.i-sparkle; text: "Clean up"; hint: "CACHE"; clicked => { root.go("cleaner"); } }
                                            }
                                            Row {
                                                Shortcut { icon: Assets.i-terminal; text: "Audit a project"; hint: "DEV"; clicked => { root.go("dev"); } }
                                                Shortcut { icon: Assets.i-vault; text: "Quarantine"; hint: root.vault-rows.length + " FILES"; clicked => { root.go("vault"); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // SCAN · choose
                if root.page == "scan" && !root.scan-started: Screen {
                    ScrollView {
                        VerticalLayout {
                            padding: 34px;
                            padding-top: 30px;
                            spacing: 20px;
                            alignment: start;
                            Header { eyebrow: "SCAN"; title: "Choose a scan"; text: "Every scan only reports at first. Nothing is moved or deleted until you decide."; }
                            GridLayout {
                                spacing: 16px;
                                Row {
                                    ScanCard { icon: Assets.i-scan; title: "Quick"; meta: "~1 MIN"; text: "Downloads, Desktop, Temp, everything that starts with Windows, and every running program."; selected: root.scan-choice == "quick"; clicked => { root.scan-choice = "quick"; } }
                                    ScanCard { icon: Assets.i-shield; title: "System"; meta: "~10 MIN"; text: "Windows system files, Program Files, ProgramData and the quick-scan places. Checks the core of your PC."; selected: root.scan-choice == "system"; clicked => { root.scan-choice = "system"; } }
                                }
                                Row {
                                    ScanCard { icon: Assets.i-disk; title: "Full"; meta: "30+ MIN"; text: "Every file on every local disk. The deepest check, best run when you're away."; selected: root.scan-choice == "full"; clicked => { root.scan-choice = "full"; } }
                                    ScanCard { icon: Assets.i-folder; title: "Custom"; meta: "YOU PICK"; text: "Tick any drives, add any folders or projects, and scan them together."; selected: root.scan-choice == "custom"; clicked => { root.scan-choice = "custom"; } }
                                }
                            }
                            if root.scan-choice == "custom": Panel {
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 12px;
                                    Eyebrow { text: "DRIVES"; }
                                    for d[i] in root.drives: Rectangle {
                                        height: 46px;
                                        HorizontalLayout {
                                            spacing: 14px;
                                            VerticalLayout { alignment: center; Check { checked: d.selected; toggled => { root.toggle-drive(i); } } }
                                            VerticalLayout { alignment: center; Image { source: Assets.i-disk; width: 20px; height: 20px; colorize: Theme.fg-2; image-rendering: pixelated; } }
                                            VerticalLayout {
                                                alignment: center;
                                                width: 330px;
                                                Text { text: d.root + "  " + d.label; font-family: Theme.body; font-size: 14px; font-weight: 600; color: Theme.fg; overflow: elide; }
                                                Mono { text: d.info; color: Theme.fg-3; font-size: 11px; }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                horizontal-stretch: 1;
                                                Rectangle {
                                                    height: 8px;
                                                    background: Theme.raised;
                                                    Rectangle { x: 0; width: parent.width * d.usage; height: parent.height; background: d.usage > 0.9 ? Theme.amber : Theme.heat-3; }
                                                }
                                            }
                                        }
                                        TouchArea { x: 0; width: 60px; clicked => { root.toggle-drive(i); } }
                                    }
                                    Eyebrow { text: "FOLDERS AND PROJECTS"; }
                                    if root.folders.length == 0: Body { text: "No folders added. Add a project, a download folder, a USB stick folder: anything."; font-size: 13px; }
                                    for f[i] in root.folders: HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout { alignment: center; Image { source: Assets.i-folder; width: 18px; height: 18px; colorize: Theme.fg-2; image-rendering: pixelated; } }
                                        Mono { text: f; vertical-alignment: center; horizontal-stretch: 1; }
                                        Btn { text: "Remove"; kind: "quiet"; small: true; clicked => { root.remove-folder(i); } }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        Btn { text: "Add folder…"; kind: "ghost"; small: true; has-icon: true; icon: Assets.i-folder; clicked => { root.add-folder(); } }
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 14px;
                                Btn {
                                    text: root.scan-choice == "quick" ? "Start quick scan" : root.scan-choice == "system" ? "Start system scan" : root.scan-choice == "full" ? "Start full scan" : "Scan selected";
                                    has-icon: true;
                                    icon: Assets.i-scan;
                                    enabled: root.engine-ready;
                                    clicked => { root.start-scan(root.scan-choice); }
                                }
                                if !root.engine-ready: VerticalLayout { alignment: center; Chip { text: "LOADING RULES"; tone: Theme.signal; } }
                            }
                        }
                    }
                }

                // SCAN · running / finished: a compact HUD.
                if root.page == "scan" && root.scan-started: Screen {
                    VerticalLayout {
                        padding: 24px;
                        padding-top: 20px;
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Chip {
                                        text: root.scanning ? (root.paused ? "PAUSED" : "LIVE") : root.scan-threats > 0 ? "THREATS FOUND" : "DONE";
                                        tone: root.scanning ? (root.paused ? Theme.amber : Theme.signal) : root.scan-threats > 0 ? Theme.alarm : Theme.accent;
                                    }
                                    Eyebrow { text: root.scan-kind; vertical-alignment: center; }
                                }
                                Text { text: root.scan-title; font-family: Theme.pixel; font-size: 26px; font-weight: 600; color: Theme.fg; }
                                Mono { text: root.scan-text; color: Theme.fg-2; font-size: 12px; }
                            }
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 10px;
                                    if root.scanning: Btn { text: root.paused ? "Resume" : "Pause"; kind: "ghost"; small: true; clicked => { root.pause-scan(); } }
                                    if root.scanning: Btn { text: "Stop"; kind: "ghost"; small: true; clicked => { root.stop-scan(); } }
                                    if !root.scanning && root.scan-threats > 0: Btn { text: "Review results"; kind: "danger"; small: true; has-icon: true; icon: Assets.i-bug; clicked => { root.go("results"); } }
                                    if !root.scanning: Btn { text: "New scan"; kind: root.scan-threats > 0 ? "ghost" : "primary"; small: true; clicked => { root.navigate("scan-new"); } }
                                    if !root.scanning: Btn { text: "Home"; kind: "ghost"; small: true; clicked => { root.go("home"); } }
                                }
                            }
                        }
                        Panel {
                            vertical-stretch: 0;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                PanelHead { title: "Progress"; note: root.scan-fraction >= 0 ? Math.floor(root.scan-fraction * 100) + "%" : "counting files…"; }
                                Blocks { value: root.scan-fraction; frame: root.frame; height: 10px; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            vertical-stretch: 0;
                            Stat { label: "FILES CHECKED"; value: root.scan-files; }
                            Stat { label: "FOUND"; value: root.scan-threats; tone: root.scan-threats > 0 ? Theme.alarm : Theme.fg; led: root.scan-threats > 0 ? Theme.alarm : Theme.accent; }
                            Stat { label: "FILES / SEC"; value: root.scan-speed; }
                            Stat { label: "ELAPSED"; value: root.scan-time; }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            vertical-stretch: 1;
                            Panel {
                                width: 300px;
                                edge: root.flash ? (Math.mod(root.frame, 4) < 2 ? Theme.alarm : Theme.line) : Theme.line;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    PanelHead { title: "Live"; note: root.scanning ? (root.paused ? "paused" : "reading") : "idle"; }
                                    Radar {
                                        min-height: 150px;
                                        vertical-stretch: 1;
                                        frame: root.frame;
                                        active: root.scanning && !root.paused;
                                        state: root.scanning ? (root.scan-threats > 0 ? "alarm" : "scan") : root.scan-threats > 0 ? "alarm" : "safe";
                                    }
                                    Text { text: root.scan-bytes; font-family: Theme.mono; font-size: 11.5px; color: Theme.fg; letter-spacing: 1px; }
                                    Mono { text: root.scan-path; color: Theme.fg-3; font-size: 10.5px; }
                                }
                            }
                            VerticalLayout {
                                spacing: 12px;
                                horizontal-stretch: 1;
                                Panel {
                                    vertical-stretch: 0;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;
                                        PanelHead { title: "Progress map"; note: "1 square ≈ 1/288 of the scan"; }
                                        Rectangle {
                                            height: 6 * 11px;
                                            for c[i] in root.grid-cells: Rectangle {
                                                x: Math.mod(i, 48) * (parent.width / 48);
                                                y: Math.floor(i / 48) * 11px;
                                                width: parent.width / 48 - 2px;
                                                height: 8px;
                                                background: c == 3 ? Theme.alarm : c == 2 ? Theme.signal : c == 1 ? Theme.heat-2 : Theme.raised;
                                            }
                                        }
                                    }
                                }
                                Panel {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;
                                        PanelHead { title: "Throughput"; note: root.scan-speed + " files/s"; }
                                        Spark { min-height: 64px; vertical-stretch: 1; values: root.scan-speed-history; tone: root.scan-threats > 0 ? Theme.alarm : Theme.signal; }
                                    }
                                }
                            }
                        }
                    }
                }

                // RESULTS
                if root.page == "results": Screen {
                    VerticalLayout {
                        padding: 34px;
                        padding-top: 30px;
                        spacing: 20px;
                        Header { eyebrow: "SCAN RESULTS"; title: root.results-title; text: root.results-text; }
                        if root.threats.length == 0: Empty { icon: Assets.i-shield; title: "Nothing to show"; text: "Results from your next scan appear here."; }
                        if root.threats.length > 0: ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 12px;
                                alignment: start;
                                for t[i] in root.threats: Panel {
                                    fill: t.done ? Theme.bg : Theme.surface;
                                    edge: t.done ? Theme.line : t.tone == "alarm" ? Theme.alarm.with-alpha(0.55) : Theme.line;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 14px;
                                        VerticalLayout {
                                            alignment: start;
                                            if !t.done: Check { checked: t.selected; toggled => { root.toggle-threat(i); } }
                                            if t.done: Image { source: Assets.i-check; width: 20px; height: 20px; colorize: Theme.accent; image-rendering: pixelated; }
                                        }
                                        VerticalLayout {
                                            spacing: 4px;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                spacing: 10px;
                                                Text { text: t.name; font-family: Theme.mono; font-size: 13px; font-weight: 600; color: t.done ? Theme.fg-3 : Theme.fg; overflow: elide; horizontal-stretch: 1; }
                                                Chip { text: t.chip; tone: Theme.tone(t.tone); }
                                            }
                                            Body { text: t.description; font-size: 13px; }
                                            Mono { text: t.path; color: Theme.fg-3; }
                                            if !t.done && !t.confirm-delete: HorizontalLayout {
                                                padding-top: 6px;
                                                spacing: 10px;
                                                alignment: start;
                                                Btn { text: "Quarantine"; small: true; has-icon: true; icon: Assets.i-vault; clicked => { root.quarantine-one(i); } }
                                                Btn { text: "Delete"; kind: "ghost"; small: true; has-icon: true; icon: Assets.i-trash; clicked => { root.ask-delete(i); } }
                                                Btn { text: "Allow"; kind: "ghost"; small: true; has-icon: true; icon: Assets.i-check; clicked => { root.allow-one(i); } }
                                                if root.cloud-samples: Btn { text: "Send to lab"; kind: "ghost"; small: true; clicked => { root.send-sample(i); } }
                                            }
                                            if !t.done && t.confirm-delete: HorizontalLayout {
                                                padding-top: 6px;
                                                spacing: 10px;
                                                alignment: start;
                                                VerticalLayout { alignment: center; Body { text: "Delete this file forever? It can't be restored."; font-size: 12px; color: Theme.alarm; wrap: no-wrap; } }
                                                Btn { text: "Delete forever"; kind: "danger"; small: true; clicked => { root.delete-one(i); } }
                                                Btn { text: "Cancel"; kind: "ghost"; small: true; clicked => { root.cancel-delete(i); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.threats.length > 0 && root.open-count > 0: HorizontalLayout {
                            spacing: 14px;
                            alignment: start;
                            Btn { text: "Quarantine " + root.selected-count + " selected"; enabled: root.selected-count > 0; has-icon: true; icon: Assets.i-vault; clicked => { root.quarantine-selected(); } }
                            VerticalLayout { alignment: center; Mono { text: "Allow = trust this exact file from now on. You can undo it in Settings."; color: Theme.fg-3; } }
                        }
                    }
                }

                // STARTUP
                if root.page == "startup": Screen {
                    VerticalLayout {
                        padding: 34px;
                        padding-top: 30px;
                        spacing: 20px;
                        Header { eyebrow: "STARTUP"; title: "What starts with Windows"; text: "Programs that start on their own are a favorite hiding place. Hexward checks each one and can switch entries off. Every change can be undone."; }
                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;
                            Btn { text: root.startup-busy ? "Checking…" : root.startup-checked ? "Check again" : "Check startup items"; enabled: root.engine-ready && !root.startup-busy; has-icon: true; icon: Assets.i-bolt; clicked => { root.check-startup(); } }
                            if root.startup-checked: Btn { text: root.startup-show-all ? "Problems only" : "Show everything"; kind: "ghost"; clicked => { root.set-show-all(!root.startup-show-all); } }
                            if root.startup-busy: VerticalLayout { alignment: center; PixelSpinner { frame: root.frame; } }
                            VerticalLayout { alignment: center; horizontal-stretch: 1; Body { text: root.startup-summary; font-size: 13px; } }
                        }
                        if root.startup-checked: HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout { alignment: center; SearchBox { text <=> root.startup-search; placeholder: "Search name, publisher, command"; width: 280px; edited => { root.startup-changed(); } } }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout { alignment: center; Mono { text: "SORT"; color: Theme.fg-3; font-size: 11px; } }
                            Seg { options: ["Problems", "Name", "Publisher", "Size"]; value: root.startup-sort; picked(v) => { root.startup-sort = v; root.startup-changed(); } }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 12px;
                                alignment: start;
                                if root.startup-checked && root.startup-rows.length == 0: Empty { icon: Assets.i-bolt; title: "No problems found"; text: "Every startup entry points to a real, clean program."; }
                                for r[i] in root.startup-rows: Panel {
                                    edge: r.tone == "alarm" ? Theme.alarm.with-alpha(0.55) : Theme.line;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 14px;
                                        VerticalLayout {
                                            alignment: start;
                                            Rectangle {
                                                width: 32px;
                                                height: 32px;
                                                if r.has-icon: Image { width: 32px; height: 32px; source: r.icon; }
                                                if !r.has-icon: Image { x: 6px; y: 6px; width: 20px; height: 20px; source: Assets.i-bolt; colorize: Theme.fg-3; image-rendering: pixelated; }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 3px;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                spacing: 10px;
                                                Text { text: r.name; font-family: Theme.body; font-size: 14px; font-weight: 600; color: Theme.fg; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                                if r.size != "": VerticalLayout { alignment: center; Mono { text: r.size; color: Theme.fg-3; font-size: 11px; } }
                                                Chip { text: r.chip; tone: Theme.tone(r.tone); }
                                            }
                                            if r.publisher != "": Text { text: r.publisher; font-family: Theme.body; font-size: 12px; color: r.signed ? Theme.fg-2 : Theme.amber; overflow: elide; }
                                            Mono { text: r.location; color: Theme.fg-3; font-size: 11px; }
                                            Mono { text: r.command; }
                                            if r.detail != "": Body { text: r.detail; font-size: 12px; color: Theme.tone(r.tone); }
                                        }
                                        if r.fixable: VerticalLayout { alignment: start; Btn { text: "Switch off"; kind: "ghost"; small: true; clicked => { root.disable-startup(i); } } }
                                    }
                                }
                                if root.disabled-rows.length > 0: Eyebrow { text: "SWITCHED OFF BY HEXWARD"; }
                                for d in root.disabled-rows: Panel {
                                    fill: Theme.bg;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 14px;
                                        VerticalLayout { alignment: start; width: 104px; Chip { text: "OFF"; tone: Theme.fg-3; } }
                                        VerticalLayout {
                                            spacing: 3px;
                                            horizontal-stretch: 1;
                                            Text { text: d.name; font-family: Theme.body; font-size: 14px; font-weight: 600; color: Theme.fg-2; }
                                            Mono { text: d.info; color: Theme.fg-3; }
                                        }
                                        VerticalLayout { alignment: start; Btn { text: "Turn back on"; kind: "ghost"; small: true; clicked => { root.restore-startup(d.id); } } }
                                    }
                                }
                            }
                        }
                    }
                }

                // DEV & AI
                if root.page == "dev": Screen {
                    VerticalLayout {
                        padding: 34px;
                        padding-top: 30px;
                        spacing: 16px;
                        Header { eyebrow: "DEV & AI"; title: "Code, agents and extensions"; text: "Supply-chain attacks hide in install scripts, editor tasks, agent configs and extensions. Hexward reads them; it never runs anything from a project."; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Btn { text: "Project audit"; small: true; kind: root.dev-tab == "audit" ? "primary" : "ghost"; clicked => { root.dev-tab = "audit"; root.dev-tab-changed("audit"); } }
                            Btn { text: root.mcp-waiting > 0 ? "AI agents · " + root.mcp-waiting : "AI agents"; small: true; kind: root.dev-tab == "agents" ? "primary" : "ghost"; clicked => { root.dev-tab = "agents"; root.dev-tab-changed("agents"); } }
                            Btn { text: "Extensions"; small: true; kind: root.dev-tab == "ext" ? "primary" : "ghost"; clicked => { root.dev-tab = "ext"; root.dev-tab-changed("ext"); } }
                        }

                        // --- Project audit ---
                        if root.dev-tab == "audit": HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 40px;
                                background: Theme.bg;
                                Edges { x: 0; y: 0; width: parent.width; height: parent.height; edge: target-input.has-focus ? Theme.accent : Theme.line-strong; }
                                if root.audit-target == "": Text { x: 12px; height: parent.height; vertical-alignment: center; text: "A project folder, or a GitHub address like https://github.com/owner/repo"; color: Theme.fg-3; font-family: Theme.body; font-size: 13px; }
                                target-input := TextInput {
                                    x: 12px;
                                    width: parent.width - 24px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    single-line: true;
                                    text <=> root.audit-target;
                                    font-family: Theme.mono;
                                    font-size: 13px;
                                    color: Theme.fg;
                                    accepted => { root.audit-run(); }
                                }
                            }
                            Btn { text: "Folder…"; kind: "ghost"; has-icon: true; icon: Assets.i-folder; clicked => { root.audit-pick(); } }
                            Btn { text: root.audit-busy ? "Auditing…" : "Audit"; has-icon: true; icon: Assets.i-terminal; enabled: !root.audit-busy; clicked => { root.audit-run(); } }
                        }
                        if root.dev-tab == "audit": HorizontalLayout {
                            spacing: 18px;
                            alignment: start;
                            HorizontalLayout { spacing: 8px; VerticalLayout { alignment: center; Check { checked: root.audit-history; toggled => { root.audit-history = !root.audit-history; } } } VerticalLayout { alignment: center; Body { text: "Search git history for old secrets"; font-size: 13px; wrap: no-wrap; } } }
                            HorizontalLayout { spacing: 8px; VerticalLayout { alignment: center; Check { checked: root.audit-online; toggled => { root.audit-online = !root.audit-online; } } } VerticalLayout { alignment: center; Body { text: "Check dependencies online (sends package names to OSV, npm, PyPI)"; font-size: 13px; wrap: no-wrap; } } }
                            HorizontalLayout { spacing: 8px; VerticalLayout { alignment: center; Check { checked: root.audit-show-info; toggled => { root.audit-show-info = !root.audit-show-info; root.audit-reshow(); } } } VerticalLayout { alignment: center; Body { text: "Show info"; font-size: 13px; wrap: no-wrap; } } }
                        }
                        if root.dev-tab == "audit" && (root.audit-busy || root.audit-done): HorizontalLayout {
                            spacing: 10px;
                            if root.audit-busy: PixelSpinner { frame: root.frame; }
                            if !root.audit-busy: VerticalLayout { alignment: center; Chip { text: root.audit-state == "alarm" ? "HIGH RISK" : root.audit-state == "warn" ? "NEEDS A LOOK" : "LOOKS CLEAN"; tone: Theme.tone(root.audit-state); } }
                            VerticalLayout { alignment: center; horizontal-stretch: 1; Mono { text: root.audit-busy ? root.audit-status : root.audit-summary; color: Theme.fg-2; } }
                        }
                        if root.dev-tab == "audit": ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 10px;
                                alignment: start;
                                if !root.audit-done && !root.audit-busy: Empty { icon: Assets.i-terminal; title: "Audit a project before you install or open it"; text: "Install scripts · agent and editor configs · hidden Unicode · GitHub Actions · leaked keys · dependencies"; }
                                if root.audit-done && root.audit-rows.length == 0: Empty { icon: Assets.i-shield; title: "Nothing risky found"; text: "No install-time tricks, agent traps, hidden text or leaked keys."; }
                                for f in root.audit-rows: Panel {
                                    edge: f.tone == "alarm" ? Theme.alarm.with-alpha(0.55) : Theme.line;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 14px;
                                        VerticalLayout { alignment: start; width: 76px; Chip { text: f.level; tone: Theme.tone(f.tone); } }
                                        VerticalLayout {
                                            spacing: 4px;
                                            horizontal-stretch: 1;
                                            Text { text: f.title; font-family: Theme.body; font-size: 14px; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
                                            Mono { text: f.category + (f.place != "" ? "  ·  " + f.place : ""); color: Theme.fg-3; font-size: 11px; }
                                            Body { text: f.detail; font-size: 12px; }
                                            if f.evidence != "": Rectangle {
                                                background: Theme.bg;
                                                height: ev.preferred-height + 12px;
                                                ev := Mono { x: 8px; width: parent.width - 16px; y: 6px; text: f.evidence; color: Theme.fg-2; font-size: 11px; }
                                            }
                                            Body { text: "Fix: " + f.fix; font-size: 12px; color: Theme.fg; }
                                        }
                                        if f.file != "": VerticalLayout { alignment: start; Btn { text: "Show"; kind: "ghost"; small: true; clicked => { root.audit-open(f.file); } } }
                                    }
                                }
                            }
                        }

                        // --- AI agents ---
                        if root.dev-tab == "agents": ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 12px;
                                alignment: start;
                                Panel {
                                    edge: root.guard-installed ? Theme.accent : Theme.line;
                                    SettingRow {
                                        last: true;
                                        title: "Hexward Guard for Claude Code";
                                        text: "Checks every command and file edit the agent is about to make. Blocks download-and-run, Defender tampering, backup deletion and credential theft; asks you before force-pushes, publishing, or edits to agent configs and git hooks.";
                                        Switch { checked: root.guard-installed; toggled(v) => { root.guard-toggle(v); } }
                                    }
                                }
                                HorizontalLayout {
                                    Eyebrow { text: "MCP SERVERS"; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.mcp-waiting > 0: Btn { text: "Approve all as they are now"; kind: "ghost"; small: true; clicked => { root.mcp-approve(""); } }
                                }
                                if root.mcp-rows.length == 0: Body { text: "No MCP servers are set up in Claude Code, Claude Desktop, Cursor, VS Code or Windsurf."; font-size: 13px; }
                                for m in root.mcp-rows: Panel {
                                    edge: m.tone == "alarm" ? Theme.alarm.with-alpha(0.6) : Theme.line;
                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 12px;
                                        VerticalLayout { alignment: start; width: 96px; Chip { text: m.status; tone: Theme.tone(m.tone); } }
                                        VerticalLayout {
                                            spacing: 3px;
                                            horizontal-stretch: 1;
                                            HorizontalLayout { spacing: 8px; Text { text: m.name; font-family: Theme.body; font-size: 14px; font-weight: 600; color: Theme.fg; overflow: elide; horizontal-stretch: 0; } Mono { text: m.app; color: Theme.fg-3; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; } }
                                            Mono { text: m.summary; }
                                            if m.note != "": Body { text: m.note; font-size: 12px; color: m.tone == "alarm" ? Theme.alarm : Theme.amber; }
                                        }
                                        if m.status != "APPROVED": VerticalLayout { alignment: start; Btn { text: "Approve"; kind: "ghost"; small: true; clicked => { root.mcp-approve(m.name); } } }
                                    }
                                }
                                Eyebrow { text: "RECENTLY STOPPED OR QUESTIONED"; }
                                if root.guard-rows.length == 0: Body { text: root.guard-installed ? "Nothing yet. Guard stays quiet until an agent tries something risky." : "Turn Guard on to see what it stops here."; font-size: 13px; }
                                for g in root.guard-rows: HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout { alignment: start; width: 84px; Chip { text: g.decision; tone: Theme.tone(g.tone); } }
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Mono { text: g.subject; color: Theme.fg; }
                                        Body { text: g.reasons; font-size: 12px; color: Theme.fg-3; }
                                    }
                                    Mono { text: g.when; color: Theme.fg-3; font-size: 11px; }
                                }
                            }
                        }

                        // --- Extensions ---
                        if root.dev-tab == "ext": HorizontalLayout {
                            spacing: 12px;
                            if root.ext-busy: PixelSpinner { frame: root.frame; }
                            VerticalLayout { alignment: center; horizontal-stretch: 1; Mono { text: root.ext-busy ? "Reading editor and browser extensions…" : root.ext-summary; color: Theme.fg-2; } }
                            Btn { text: "Check again"; kind: "ghost"; small: true; enabled: !root.ext-busy; clicked => { root.ext-refresh(); } }
                        }
                        if root.dev-tab == "ext": ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 8px;
                                alignment: start;
                                for x in root.ext-rows: Panel {
                                    edge: x.tone == "alarm" ? Theme.alarm.with-alpha(0.6) : x.tone == "warn" ? Theme.amber.with-alpha(0.5) : Theme.line;
                                    fill: x.change == "REMOVED" ? Theme.bg : Theme.surface;
                                    HorizontalLayout {
                                        padding: 10px;
                                        padding-left: 14px;
                                        spacing: 12px;
                                        VerticalLayout { alignment: start; width: 76px; if x.level != "": Chip { text: x.level; tone: Theme.tone(x.tone); } }
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: x.name; font-family: Theme.body; font-size: 13px; font-weight: 600; color: x.change == "REMOVED" ? Theme.fg-3 : Theme.fg; overflow: elide; horizontal-stretch: 1; }
                                                if x.change != "": Chip { text: x.change; tone: x.change == "REMOVED" ? Theme.fg-3 : Theme.signal; }
                                            }
                                            Mono { text: x.app + " · " + x.version + (x.id != "" ? " · " + x.id : ""); color: Theme.fg-3; font-size: 11px; }
                                            if x.notes != "": Body { text: x.notes; font-size: 12px; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // CLEANER
                if root.page == "cleaner": Screen {
                    VerticalLayout {
                        padding: 34px;
                        padding-top: 30px;
                        spacing: 18px;
                        Header { eyebrow: "CLEANER"; title: "Free up space"; text: "Browser caches and Windows leftovers, measured before anything is deleted. Bookmarks and saved passwords are never touched. Files in use are skipped."; }
                        HorizontalLayout {
                            spacing: 14px;
                            Stat { label: "FOUND"; value: root.cleaner-analyzed ? root.cleaner-found : "…"; }
                            Stat { label: "TICKED TO CLEAN"; value: root.cleaner-analyzed ? root.cleaner-selected : "…"; tone: root.cleaner-has-selection ? Theme.accent : Theme.fg; }
                            Stat { label: "BROWSERS FOUND"; value: root.cleaner-analyzed ? root.cleaner-browsers : "…"; }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 12px;
                                alignment: start;
                                if !root.cleaner-analyzed: HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    PixelSpinner { frame: root.frame; }
                                    VerticalLayout { alignment: center; Body { text: "Finding browsers and measuring junk files…"; font-size: 13px; } }
                                }
                                for g in root.cleaner-groups: Panel {
                                    edge: g.running ? Theme.amber.with-alpha(0.6) : Theme.line;
                                    VerticalLayout {
                                        padding: 14px;
                                        padding-left: 16px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            padding-bottom: 6px;
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    if g.has-icon: Image { width: 28px; height: 28px; source: g.icon; }
                                                    if !g.has-icon: Image { x: 4px; y: 4px; width: 20px; height: 20px; source: g.id == "windows" ? Assets.i-disk : Assets.i-file; colorize: Theme.fg-2; image-rendering: pixelated; }
                                                }
                                            }
                                            VerticalLayout { alignment: center; Text { text: g.name; font-family: Theme.body; font-size: 15px; font-weight: 600; color: Theme.fg; } }
                                            if g.running: VerticalLayout { alignment: center; Chip { text: "OPEN"; tone: Theme.amber; } }
                                            Rectangle { horizontal-stretch: 1; }
                                            if g.running: VerticalLayout { alignment: center; Btn { text: "Close " + g.name; kind: "ghost"; small: true; enabled: !root.cleaner-busy; clicked => { root.cleaner-close-browser(g.id); } } }
                                            VerticalLayout { alignment: center; Mono { text: g.total; color: Theme.fg-2; font-size: 13px; } }
                                        }
                                        for it in g.items: Rectangle {
                                            min-height: 44px;
                                            HorizontalLayout {
                                                spacing: 12px;
                                                padding-top: 4px;
                                                padding-bottom: 4px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    if it.available: Check { checked: it.checked; toggled => { root.cleaner-toggle(it.id); } }
                                                    if !it.available: Rectangle { width: 20px; height: 20px; Image { x: 2px; y: 2px; width: 16px; height: 16px; source: Assets.i-lock; colorize: Theme.fg-3; image-rendering: pixelated; } }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 2px;
                                                    horizontal-stretch: 1;
                                                    Text { text: it.label; font-family: Theme.body; font-size: 13px; font-weight: 600; color: it.available ? Theme.fg : Theme.fg-3; }
                                                    Body { text: it.description; font-size: 12px; color: Theme.fg-3; }
                                                }
                                                VerticalLayout { alignment: center; width: 170px; Mono { text: it.size; horizontal-alignment: right; color: it.checked ? Theme.fg : Theme.fg-3; } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.cleaner-blocked != "": HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; background: Theme.amber; } }
                            Body { text: root.cleaner-blocked; font-size: 13px; color: Theme.amber; }
                        }
                        if !root.cleaner-confirm: HorizontalLayout {
                            spacing: 14px;
                            alignment: start;
                            Btn { text: "Clean " + root.cleaner-selected; has-icon: true; icon: Assets.i-sparkle; enabled: root.cleaner-analyzed && root.cleaner-has-selection && !root.cleaner-busy; clicked => { root.cleaner-confirm = true; } }
                            Btn { text: "Measure again"; kind: "ghost"; enabled: !root.cleaner-busy; clicked => { root.cleaner-analyze(); } }
                            if root.cleaner-busy: VerticalLayout { alignment: center; PixelSpinner { frame: root.frame; } }
                            VerticalLayout { alignment: center; Mono { text: root.cleaner-status; color: Theme.fg-3; } }
                        }
                        if root.cleaner-confirm: HorizontalLayout {
                            spacing: 14px;
                            alignment: start;
                            VerticalLayout { alignment: center; Body { text: "Delete " + root.cleaner-selected + " of ticked files? This can't be undone."; font-size: 13px; color: Theme.fg; wrap: no-wrap; } }
                            Btn { text: "Clean now"; kind: "danger"; clicked => { root.cleaner-clean(); } }
                            Btn { text: "Cancel"; kind: "ghost"; clicked => { root.cleaner-confirm = false; } }
                        }
                    }
                }

                // TASKS
                if root.page == "tasks": Screen {
                    VerticalLayout {
                        padding: 34px;
                        padding-top: 30px;
                        spacing: 18px;
                        Header { eyebrow: "TASK MANAGER"; title: "What's running"; text: "Everything running on this PC, sorted into apps, background programs and Windows itself. Windows and security programs are locked, so nothing vital gets closed by accident."; }
                        HorizontalLayout {
                            spacing: 14px;
                            Stat { label: "CPU"; value: root.tasks-cpu; }
                            Stat { label: "MEMORY IN USE"; value: root.tasks-mem; big: false; }
                            Stat { label: "PROGRAMS"; value: root.tasks-n-apps + root.tasks-n-background + root.tasks-n-windows; }
                            Stat { label: "WORTH A LOOK"; value: root.tasks-risky; tone: root.tasks-risky > 0 ? Theme.amber : Theme.fg; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Btn { text: root.tasks-memory-busy ? "Reading memory…" : "Scan memory"; small: true; kind: "ghost"; has-icon: true; icon: Assets.i-scan; enabled: !root.tasks-memory-busy && root.engine-ready; clicked => { root.tasks-scan-memory(); } }
                            Btn { text: "Apps · " + root.tasks-n-apps; small: true; kind: root.tasks-group == "apps" ? "primary" : "ghost"; clicked => { root.tasks-group = "apps"; root.tasks-changed(); } }
                            Btn { text: "Background · " + root.tasks-n-background; small: true; kind: root.tasks-group == "background" ? "primary" : "ghost"; clicked => { root.tasks-group = "background"; root.tasks-changed(); } }
                            Btn { text: "Windows · " + root.tasks-n-windows; small: true; kind: root.tasks-group == "windows" ? "primary" : "ghost"; clicked => { root.tasks-group = "windows"; root.tasks-changed(); } }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout { alignment: center; SearchBox { text <=> root.tasks-search; placeholder: "Search programs"; edited => { root.tasks-changed(); } } }
                            Seg { options: ["Name", "CPU", "Memory"]; value: root.tasks-sort; picked(v) => { root.tasks-sort = v; root.tasks-changed(); } }
                        }
                        if root.tasks-group == "windows": HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout { alignment: center; Image { source: Assets.i-lock; width: 16px; height: 16px; colorize: Theme.fg-3; image-rendering: pixelated; } }
                            Body { text: "These are part of Windows. Ending them can crash or freeze the PC, so Hexward only shows them."; font-size: 13px; color: Theme.fg-3; }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 8px;
                                alignment: start;
                                if root.tasks-loading: HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    PixelSpinner { frame: root.frame; }
                                    VerticalLayout { alignment: center; Body { text: "Reading running programs…"; font-size: 13px; } }
                                }
                                if !root.tasks-loading && root.tasks.length == 0: Empty { icon: Assets.i-tasks; title: "Nothing here"; text: root.tasks-search != "" ? "No program matches that search." : "No programs in this group right now."; }
                                for t in root.tasks: Panel {
                                    fill: t.confirm ? Theme.raised : Theme.surface;
                                    edge: t.confirm ? Theme.alarm.with-alpha(0.6) : t.risky ? Theme.amber.with-alpha(0.7) : Theme.line;
                                    HorizontalLayout {
                                        padding: 10px;
                                        padding-left: 14px;
                                        padding-right: 12px;
                                        spacing: 14px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 32px;
                                                height: 32px;
                                                if t.has-icon: Image { x: 0; y: 0; width: 32px; height: 32px; source: t.icon; }
                                                if !t.has-icon: Image { x: 6px; y: 6px; width: 20px; height: 20px; source: t.protected ? Assets.i-shield : Assets.i-file; colorize: Theme.fg-3; image-rendering: pixelated; }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: t.name; font-family: Theme.body; font-size: 14px; font-weight: 600; color: Theme.fg; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                                if t.risky: Chip { text: "UNSIGNED · RISKY FOLDER"; tone: Theme.amber; }
                                                if t.protected: Chip { text: "LOCKED"; tone: Theme.fg-3; }
                                            }
                                            Mono { text: t.detail; color: Theme.fg-3; font-size: 11px; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 5px;
                                            width: 84px;
                                            Mono { text: "CPU " + t.cpu; font-size: 11px; color: Theme.fg-2; }
                                            Meter { value: t.cpu-frac * 4; tone: t.cpu-frac > 0.2 ? Theme.amber : Theme.signal; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 5px;
                                            width: 84px;
                                            Mono { text: t.mem; font-size: 11px; color: Theme.fg-2; }
                                            Meter { value: t.mem-frac; }
                                        }
                                        if !t.confirm: HorizontalLayout {
                                            spacing: 6px;
                                            alignment: end;
                                            width: 238px;
                                            VerticalLayout { alignment: center; Btn { text: "Scan"; kind: "ghost"; small: true; enabled: t.path != "" && root.engine-ready && !root.tasks-scanning; clicked => { root.task-scan(t.path); } } }
                                            VerticalLayout { alignment: center; Btn { text: "Folder"; kind: "quiet"; small: true; enabled: t.path != ""; clicked => { root.task-open(t.path); } } }
                                            if !t.protected: VerticalLayout { alignment: center; Btn { text: "End task"; kind: "ghost"; small: true; clicked => { root.task-ask-end(t.pid); } } }
                                            if t.protected: VerticalLayout { alignment: center; Rectangle { width: 74px; Image { x: (parent.width - 16px) / 2; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: Assets.i-lock; colorize: Theme.fg-3; image-rendering: pixelated; } } }
                                        }
                                        if t.confirm: HorizontalLayout {
                                            spacing: 6px;
                                            alignment: end;
                                            width: 238px;
                                            VerticalLayout { alignment: center; Btn { text: "End it"; kind: "danger"; small: true; clicked => { root.task-end(t.pid); } } }
                                            VerticalLayout { alignment: center; Btn { text: "Cancel"; kind: "ghost"; small: true; clicked => { root.task-ask-end(-1); } } }
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            if root.tasks-scanning: PixelSpinner { frame: root.frame; }
                            VerticalLayout { alignment: center; Mono { text: root.tasks-scanning ? "Scanning that program…" : "Ending a task closes every window of that program. Unsaved work in it is lost."; color: Theme.fg-3; } }
                        }
                    }
                }

                // QUARANTINE
                if root.page == "vault": Screen {
                    VerticalLayout {
                        padding: 34px;
                        padding-top: 30px;
                        spacing: 20px;
                        Header { eyebrow: "QUARANTINE"; title: "Locked away"; text: "Files here are encrypted and can't run. Restore puts a file back exactly where it was."; }
                        if root.vault-rows.length == 0: Empty { icon: Assets.i-vault; title: "Quarantine is empty"; text: "Nothing has been locked away. That's good."; }
                        if root.vault-rows.length > 0: ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 12px;
                                alignment: start;
                                for v[i] in root.vault-rows: Panel {
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 14px;
                                        VerticalLayout { alignment: start; Image { source: Assets.i-vault; width: 24px; height: 24px; colorize: Theme.alarm; image-rendering: pixelated; } }
                                        VerticalLayout {
                                            spacing: 3px;
                                            horizontal-stretch: 1;
                                            Text { text: v.name; font-family: Theme.mono; font-size: 13px; font-weight: 600; color: Theme.fg; overflow: elide; }
                                            Mono { text: v.path; }
                                            Mono { text: v.info; color: Theme.fg-3; font-size: 11px; }
                                        }
                                        if !v.confirm: VerticalLayout {
                                            alignment: start;
                                            HorizontalLayout {
                                                spacing: 10px;
                                                Btn { text: "Restore"; kind: "ghost"; small: true; clicked => { root.vault-restore(v.id); } }
                                                Btn { text: "Delete forever"; kind: "ghost"; small: true; has-icon: true; icon: Assets.i-trash; clicked => { root.vault-ask(i); } }
                                            }
                                        }
                                        if v.confirm: VerticalLayout {
                                            alignment: start;
                                            HorizontalLayout {
                                                spacing: 10px;
                                                VerticalLayout { alignment: center; Body { text: "Delete forever? This can't be undone."; font-size: 12px; color: Theme.alarm; wrap: no-wrap; } }
                                                Btn { text: "Delete"; kind: "danger"; small: true; clicked => { root.vault-delete(v.id); } }
                                                Btn { text: "Cancel"; kind: "ghost"; small: true; clicked => { root.vault-cancel(i); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // HISTORY
                if root.page == "history": Screen {
                    VerticalLayout {
                        padding: 34px;
                        padding-top: 30px;
                        spacing: 20px;
                        Header { eyebrow: "HISTORY"; title: "A year of protection"; text: "Every scan and action, from the app or the command line. Stored only on this PC."; }
                        Panel {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;
                                Heat { cells: root.heat-year; cell: 11px; gap: 3px; }
                                Legend { }
                            }
                        }
                        if root.events.length == 0: Body { text: "No activity yet. Run a scan to start the record."; }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                for e in root.events: Rectangle {
                                    height: 60px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 10px;
                                        spacing: 16px;
                                        VerticalLayout { alignment: center; width: 116px; Chip { text: e.chip; tone: Theme.tone(e.tone); } }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            horizontal-stretch: 1;
                                            Text { text: e.title; font-family: Theme.body; font-size: 14px; font-weight: 600; color: Theme.fg; overflow: elide; }
                                            Mono { text: e.detail; color: Theme.fg-3; }
                                        }
                                        VerticalLayout { alignment: center; Mono { text: e.when; color: Theme.fg-3; } }
                                    }
                                    Rectangle { x: 0; y: parent.height - 2px; width: parent.width; height: 2px; background: Theme.line; }
                                }
                            }
                        }
                    }
                }

                // SETTINGS
                if root.page == "settings": Screen {
                    ScrollView {
                        VerticalLayout {
                            padding: 34px;
                            padding-top: 30px;
                            spacing: 14px;
                            alignment: start;
                            Header { eyebrow: "SETTINGS"; title: "Settings"; text: ""; }
                            Eyebrow { text: "APPEARANCE"; }
                            Panel {
                                VerticalLayout {
                                    SettingRow { title: "Dark theme"; text: "Ink background, easy on the eyes. Turn off for the light Paper theme."; Switch { checked: Theme.dark; toggled(v) => { root.set-dark(v); } } }
                                    SettingRow { title: "Start with Windows"; text: "Hexward starts quietly in the notification area when you sign in, so the shields protect you even before you open it. No administrator rights needed."; Switch { checked: root.start-with-windows; toggled(v) => { root.set-start-with-windows(v); } } }
                                    SettingRow { title: "Quiet mode for games and presentations"; text: "While a game or video is full screen or you're presenting, notifications wait and scans pause. Real threats still alert you."; Switch { checked: root.quiet-mode; toggled(v) => { root.set-quiet-mode(v); } } }
                                    SettingRow { title: "Keep running in the tray"; text: "Closing the window keeps Hexward in the notification area, so scans finish and alerts still reach you."; last: true; Switch { checked: root.close-to-tray; toggled(v) => { root.set-close-to-tray(v); } } }
                                }
                            }
                            Eyebrow { text: "REAL-TIME PROTECTION"; }
                            Panel {
                                VerticalLayout {
                                    SettingRow { title: "File shield"; text: root.shield-info; Switch { checked: root.file-shield; toggled(v) => { root.set-file-shield(v); } } }
                                    SettingRow { title: "Process shield"; text: "Checks every program the moment it starts. Each program file is checked once until it changes."; Switch { checked: root.process-shield; toggled(v) => { root.set-process-shield(v); } } }
                                    SettingRow { title: "ClickFix shield"; text: "Catches fake \"verify you're human\" pages that copy a command for you to paste. Clear-cut ones are replaced on the clipboard."; Switch { checked: root.clickfix-shield; toggled(v) => { root.set-clickfix-shield(v); } } }
                                    SettingRow { title: "Script shield (AMSI)"; text: root.script-shield-busy ? "Waiting for Windows' administrator prompt…" : "Checks PowerShell, VBScript, JScript and Office macros as they run, after they're decoded. Turning it on asks for administrator approval once."; Switch { checked: root.script-shield; toggled(v) => { root.set-script-shield(v); } } }
                                    SettingRow { title: "Ransomware shield"; text: "Keeps hidden decoy files in your folders and watches for files being renamed or encrypted in bulk. Stops the unsigned program doing it, and blocks attempts to delete Windows' backup copies."; Switch { checked: root.ransomware-shield; toggled(v) => { root.set-ransomware-shield(v); } } }
                                    SettingRow { title: "Stealer shield"; text: "Alerts when a program that isn't your browser, Discord, Telegram or wallet opens their saved passwords, cookies or keys."; Switch { checked: root.stealer-shield; toggled(v) => { root.set-stealer-shield(v); } } }
                                    SettingRow {
                                        title: "Quarantine confirmed threats automatically";
                                        text: "Known-bad files and high-confidence rules only. Suspicious finds always wait for you.";
                                        last: true;
                                        Switch { checked: root.auto-quarantine; toggled(v) => { root.set-auto-quarantine(v); } }
                                    }
                                }
                            }
                            Eyebrow { text: "SCANNING"; }
                            Panel {
                                VerticalLayout {
                                    SettingRow { title: "Skip files larger than"; text: "Bigger files take longer and rarely carry malware."; Seg { options: ["32 MB", "64 MB", "128 MB", "256 MB"]; value: root.max-size-mb + " MB"; picked(o) => { root.set-max-size(o); } } }
                                    SettingRow { title: "Select suspicious files too"; text: "Off: only confirmed threats are pre-selected for quarantine. Suspicious files are listed so you decide."; last: true; Switch { checked: root.quarantine-suspicious; toggled(v) => { root.set-quarantine-suspicious(v); } } }
                                }
                            }
                            Eyebrow { text: "DOCUMENT BACKUP"; }
                            Panel {
                                VerticalLayout {
                                    SettingRow { title: "Back up documents and photos"; text: "A private copy of Documents, Desktop and Pictures (up to 2 GB, files up to 20 MB), on this PC only. A version that looks encrypted never replaces a good copy."; Switch { checked: root.document-backup; toggled(v) => { root.set-document-backup(v); } } }
                                    SettingRow { title: "Restore files after ransomware"; text: "Puts back files that were damaged, renamed or removed since just before the last ransomware alert (or in the last 2 hours). Your own edits are left alone."; last: true; Btn { text: "Restore"; kind: "ghost"; small: true; clicked => { root.restore-files(); } } }
                                }
                            }
                            Eyebrow { text: "CLOUD (OPTIONAL, ALL OFF UNTIL YOU TURN THEM ON)"; }
                            Panel {
                                VerticalLayout {
                                    SettingRow { title: "Cloud reputation"; text: "When a program or script lands, Hexward sends the first 6 of the 64 characters of its fingerprint and compares the answer on this PC. The server can't tell which file it was."; Switch { checked: root.cloud-reputation; toggled(v) => { root.set-cloud-reputation(v); } } }
                                    SettingRow { title: "Send detection reports"; text: "The file's name (never its folder), fingerprint and detection name, so false alarms get fixed for everyone. Kept 90 days. Allow also reports a false alarm."; Switch { checked: root.cloud-reports; toggled(v) => { root.set-cloud-reports(v); } } }
                                    SettingRow { title: "Share anonymous counts"; text: "Once an hour, sends only numbers (scans, files, threats found, quarantined and blocked; includes results already in your History, once) for the counter on hexward.onurilabs.com, never file names, fingerprints or folders."; Switch { checked: root.cloud-counts; toggled(v) => { root.set-cloud-counts(v); } } }
                                    SettingRow { title: "Send samples to the lab"; text: "Adds a \"Send to lab\" button to results. Nothing is sent until you click it. See hexward.onurilabs.com/transparency."; last: true; Switch { checked: root.cloud-samples; toggled(v) => { root.set-cloud-samples(v); } } }
                                }
                            }
                            Eyebrow { text: "TRUSTED FILES"; }
                            Panel {
                                VerticalLayout {
                                    if root.allow-rows.length == 0: SettingRow { title: "No trusted files"; text: "Files you Allow from scan results are listed here, and Hexward never flags them again."; last: true; }
                                    for a[i] in root.allow-rows: SettingRow {
                                        title: a.name;
                                        text: a.path;
                                        last: i == root.allow-rows.length - 1;
                                        Btn { text: "Stop trusting"; kind: "ghost"; small: true; clicked => { root.allow-remove(a.sha); } }
                                    }
                                }
                            }
                            Eyebrow { text: "RULES"; }
                            Panel {
                                VerticalLayout {
                                    SettingRow { title: "YARA Forge rule pack"; text: "Core: about 5,100 tested rules. Extended: more coverage, a little more noise."; Seg { options: ["core", "extended"]; value: root.pack; picked(o) => { root.set-pack(o); } } }
                                    SettingRow { title: "Update rules"; text: root.rules-info; Btn { text: root.updating ? "Updating…" : "Update now"; enabled: !root.updating; small: true; has-icon: true; icon: Assets.i-update; clicked => { root.update-rules(); } } }
                                    SettingRow { title: "MalwareBazaar hash list"; text: root.bazaar-info; last: true; }
                                }
                            }
                            Eyebrow { text: "DATA"; }
                            Panel {
                                VerticalLayout {
                                    SettingRow { title: "Data folder"; text: root.data-dir; last: true; Btn { text: "Open"; kind: "ghost"; small: true; has-icon: true; icon: Assets.i-folder; clicked => { root.open-data-dir(); } } }
                                }
                            }
                        }
                    }
                }

                // ABOUT
                if root.page == "about": Screen {
                    VerticalLayout {
                        padding: 34px;
                        padding-top: 30px;
                        spacing: 22px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 24px;
                            alignment: start;
                            PixelMark { size: 96px; build: root.boot; frame: root.frame; }
                            VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                Image { source: Assets.wordmark; height: 35px; width: 205px; colorize: Theme.fg; image-rendering: pixelated; }
                                Mono { text: "Version " + root.version + " · " + root.engine-status; color: Theme.fg-3; }
                            }
                        }
                        Text { text: "Every byte, warded."; font-family: Theme.pixel; font-size: 24px; color: Theme.accent; }
                        Body { text: "Hexward is a free, open-source malware scanner for Windows, written fully in Rust. No account, no ads, no paid tier."; }
                        Panel {
                            edge: root.app-update-available ? Theme.accent : Theme.line;
                            HorizontalLayout {
                                padding: 16px;
                                spacing: 14px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text { text: root.app-update-available ? "Version " + root.app-update-version + " is available" : "App updates"; font-family: Theme.body; font-size: 14px; font-weight: 600; color: Theme.fg; }
                                    Mono { text: root.app-update-status; color: Theme.fg-3; }
                                }
                                if root.app-update-busy: VerticalLayout { alignment: center; PixelSpinner { frame: root.frame; } }
                                if root.app-update-available: Btn { text: "Update and restart"; enabled: !root.app-update-busy; small: true; clicked => { root.install-app-update(); } }
                                if !root.app-update-available: Btn { text: "Check for updates"; kind: "ghost"; small: true; enabled: !root.app-update-busy; clicked => { root.check-app-update(); } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            Stat { label: "LICENSE"; value: "GPL-3.0"; big: false; }
                            Stat { label: "RULES LOADED"; value: root.rules-count; big: false; }
                            Stat { label: "LAB TESTS"; value: "Not tested yet"; big: false; }
                            Stat { label: "REAL-TIME SHIELDS"; value: root.file-shield || root.process-shield ? "On (user mode)" : "Off"; big: false; }
                        }
                        Body { text: "Detection uses community YARA rules from YARA Forge (each keeps its author's license) and, with an Auth-Key, abuse.ch MalwareBazaar hashes (CC0). Fonts: Pixelify Sans, Geist, Geist Mono (SIL Open Font License). Updates are signed and verified before they install."; font-size: 12px; color: Theme.fg-3; }
                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;
                            Btn { text: root.updating ? "Updating…" : "Update rules"; enabled: !root.updating; has-icon: true; icon: Assets.i-update; clicked => { root.update-rules(); } }
                            Btn { text: "Open data folder"; kind: "ghost"; has-icon: true; icon: Assets.i-folder; clicked => { root.open-data-dir(); } }
                        }
                    }
                }

                // Threat flash: red pixel frame around the content.
                if root.flash: Rectangle {
                    for i in 4: Rectangle {
                        x: i == 1 ? parent.width - 4px : 0px;
                        y: i == 3 ? parent.height - 4px : 0px;
                        width: i < 2 ? 4px : parent.width;
                        height: i < 2 ? parent.height : 4px;
                        background: Theme.alarm;
                        opacity: Math.mod(root.frame, 6) < 3 ? 0.9 : 0.25;
                    }
                }
            }
        }
    }

    // Window edge (no system frame).
    Rectangle {
        border-width: 1px;
        border-color: Theme.line-strong;
        width: root.width;
        height: root.height;
    }

    // Resize handles.
    if !root.is-max: ResizeEdge { x: 0; y: 6px; width: 5px; height: root.height - 12px; mouse-cursor: ew-resize; dir: "w"; resize(d) => { root.resize-window(d); } }
    if !root.is-max: ResizeEdge { x: root.width - 5px; y: 6px; width: 5px; height: root.height - 12px; mouse-cursor: ew-resize; dir: "e"; resize(d) => { root.resize-window(d); } }
    if !root.is-max: ResizeEdge { x: 6px; y: root.height - 5px; width: root.width - 12px; height: 5px; mouse-cursor: ns-resize; dir: "s"; resize(d) => { root.resize-window(d); } }
    if !root.is-max: ResizeEdge { x: 6px; y: 0; width: root.width - 12px; height: 4px; mouse-cursor: ns-resize; dir: "n"; resize(d) => { root.resize-window(d); } }
    if !root.is-max: ResizeEdge { x: root.width - 10px; y: root.height - 10px; width: 10px; height: 10px; mouse-cursor: nwse-resize; dir: "se"; resize(d) => { root.resize-window(d); } }
    if !root.is-max: ResizeEdge { x: 0; y: root.height - 10px; width: 10px; height: 10px; mouse-cursor: nesw-resize; dir: "sw"; resize(d) => { root.resize-window(d); } }

    // Toasts: up to three, newest at the bottom, each as tall as its text.
    VerticalLayout {
        width: 400px;
        x: root.width - self.width - 24px;
        y: root.height - self.preferred-height - 24px;
        height: self.preferred-height;
        spacing: 10px;
        for t in root.toasts: ToastCard {
            item: t;
            frame: root.frame;
            dismiss => { root.toast-dismiss(t.id); }
            act => {
                root.toast-act(t.id);
                if t.target != "" { root.go(t.target); }
            }
            hover(h) => { root.toast-hover(t.id, h); }
        }
    }
}
